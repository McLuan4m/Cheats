-- ─────────────────────────────────────────────────────────────
--  CONFIG SCHEMA — tipo, faixa válida e efeito de cada opção.
-- ─────────────────────────────────────────────────────────────
local function bool(effect: Effect): FieldSpec
	return { kind = "boolean", effect = effect }
end

local function num(min: number, max: number, effect: Effect, integer: boolean?): FieldSpec
	return { kind = "number", effect = effect, min = min, max = max, integer = integer }
end

local function color(effect: Effect): FieldSpec
	return { kind = "color", effect = effect }
end

local function str(effect: Effect): FieldSpec
	return { kind = "string", effect = effect }
end

local function enum(values: { string }, effect: Effect): FieldSpec
	local options: { [string]: boolean } = {}
	for _, v in values do
		options[v] = true
	end
	return { kind = "enum", effect = effect, options = options }
end

