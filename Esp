-- uma tabela em vez de 12 locais: o chunk principal tem limite de 200
local frameCam = {
	px = 0, py = 0, pz = 0,
	rx = 1, ry = 0, rz = 0,
	ux = 0, uy = 1, uz = 0,
	lx = 0, ly = 0, lz = -1,
}

local theme: Theme = {
	uiScale = 1,
	nameSize = 13,
	distSize = 11,
	boxAlpha = 1,
	shadowAlpha = 0.55,
	fillAlpha = 0.2,
	tracerAlpha = 0.55,
	fadeMid = 1,
	fadeFar = 1,
	hpLut = {},
	bandColor = {},
	bandAlpha = {},
}

-- ─────────────────────────────────────────────────────────────
--  UTILITIES — conexões e erros
-- ─────────────────────────────────────────────────────────────
local function disconnectAll(list: { RBXScriptConnection })
	for i = #list, 1, -1 do
		list[i]:Disconnect()
		list[i] = nil
	end
end

local lastErrorAt = -math.huge
local suppressedErrors = 0

-- Erros nunca são engolidos: são reportados com traceback, com limite de
-- frequência para não inundar o console quando ocorrem a cada frame.
local function reportError(context: string, err: unknown)
	local now = os.clock()
	if now - lastErrorAt < TUNING.ErrorReportInterval then
		suppressedErrors += 1
		return
	end
	local suffix = if suppressedErrors > 0 then string.format(" (+%d suprimidos)", suppressedErrors) else ""
	lastErrorAt = now
	suppressedErrors = 0
	warn(string.format("[ESP] erro em %s%s:\n%s", context, suffix, tostring(err)))
end

-- Handler do xpcall guarda o traceback num upvalue (sem closure por chamada).
local lastTrace = ""
local function captureTrace(err: unknown)
	lastTrace = debug.traceback(tostring(err), 2)
end

local function guard<A...>(context: string, fn: (A...) -> ()): (A...) -> ()
	return function(...: A...)
		if not xpcall(fn, captureTrace, ...) then
			reportError(context, lastTrace)
		end
	end
end

-- ─────────────────────────────────────────────────────────────
--  THEME — valores derivados da config, recalculados só quando
--  uma opção visual ou a altura da tela muda.
-- ─────────────────────────────────────────────────────────────
local function computeUiScale(): number
	if not cfg.TextAutoScale or vpY <= 0 then
		return 1
	end
	return math.clamp(vpY / TUNING.ReferenceHeight, TUNING.UiScaleMin, TUNING.UiScaleMax)
end

local function rebuildTheme()
	local scale = computeUiScale()
	theme.uiScale = scale
	theme.nameSize = math.floor(cfg.TextSize * scale + 0.5)
	theme.distSize = math.floor(cfg.DistTextSize * scale + 0.5)
	theme.boxAlpha = 1 - cfg.BoxTrans
	theme.shadowAlpha = 1 - cfg.ShadowTrans
	theme.fillAlpha = 1 - cfg.BoxFillTrans
	theme.tracerAlpha = 1 - cfg.TracerTrans
	theme.fadeFar = if cfg.DistanceFade then cfg.FadeFar else 1
	theme.fadeMid = (1 + theme.fadeFar) * 0.5

	local hi, mid, lo = cfg.HpHigh, cfg.HpMid, cfg.HpLow
	local lut = theme.hpLut
	for i = 0, HP_STEPS do
		local t = i / HP_STEPS
		lut[i + 1] = if t > 0.5 then mid:Lerp(hi, (t - 0.5) * 2) else lo:Lerp(mid, t * 2)
	end

	local tc, bc = cfg.BoxFillTopColor, cfg.BoxFillBotColor
	local tt, bt = cfg.BoxFillTopTrans, cfg.BoxFillBotTrans
	for i = 1, FILL_BANDS do
		local t = (i - 0.5) / FILL_BANDS -- 0 = topo, 1 = base
		theme.bandColor[i] = tc:Lerp(bc, t)
		theme.bandAlpha[i] = 1 - (tt + (bt - tt) * t)
	end
end

local function hpColor(hp01: number): Color3
	return theme.hpLut[math.floor(math.clamp(hp01, 0, 1) * HP_STEPS) + 1]
end

local function fadeForTier(tier: number): number
	if tier == 3 then
		return theme.fadeFar
	elseif tier == 2 then
		return theme.fadeMid
	end
	return 1
end

-- ─────────────────────────────────────────────────────────────
--  DRAWING POOLS — reaproveitam drawings entre jogadores. O estilo é
--  sempre reaplicado na aquisição e texto/cor dinâmicos são resetados.
-- ─────────────────────────────────────────────────────────────
local squarePool: { DrawingSquare } = {}
local linePool: { DrawingLine } = {}
local textPool: { DrawingText } = {}

local function removeDrawing(obj: AnyDrawing)
	-- :Remove() é o padrão; alguns executores só expõem :Destroy().
	-- Chamada dinâmica porque o método disponível varia por executor.
	local dynamic = obj :: any
	if not pcall(function()
		dynamic:Remove()
	end) then
		pcall(function()
			dynamic:Destroy()
		end)
	end
end

-- Se a primeira escrita falhar, o objeto recém-criado é removido em vez de
-- ficar órfão (ninguém mais teria referência a ele).
local function hideNew<T>(obj: T, setHidden: (T) -> ()): T
	local ok, err = pcall(setHidden, obj)
	if not ok then
		removeDrawing(obj :: any)
		error(err, 0)
	end
	return obj
end

local function createSquare(): DrawingSquare
	return hideNew(Drawing.new("Square"), function(o: DrawingSquare)
		o.Visible = false
	end)
end

local function createLine(): DrawingLine
	return hideNew(Drawing.new("Line"), function(o: DrawingLine)
		o.Visible = false
	end)
end

local function createText(): DrawingText
	return hideNew(Drawing.new("Text"), function(o: DrawingText)
		o.Visible = false
	end)
end

local function takePooled<T>(pool: { T }, create: () -> T): T
	local n = #pool
	if n > 0 then
		local obj = pool[n]
		pool[n] = nil
		return obj
	end
	return create()
end

local function tryPool<T>(pool: { T }, obj: T): boolean
	if destroyed or #pool >= TUNING.PoolLimit then
		return false
	end
	table.insert(pool, obj)
	return true
end

local function drainPools()
	for i = #squarePool, 1, -1 do
		removeDrawing(squarePool[i])
		squarePool[i] = nil
	end
	for i = #linePool, 1, -1 do
		removeDrawing(linePool[i])
		linePool[i] = nil
	end
	for i = #textPool, 1, -1 do
		removeDrawing(textPool[i])
		textPool[i] = nil
	end
end

-- ─────────────────────────────────────────────────────────────
--  ITEM VISIBILITY — escreve no Drawing só quando o estado muda.
-- ─────────────────────────────────────────────────────────────
local function setVisible(item: Item, value: boolean)
	if item.vis == value then
		return
	end
	item.vis = value
	if item.kind == "Square" then
		item.obj.Visible = value
	elseif item.kind == "Line" then
		item.obj.Visible = value
	else
		item.obj.Visible = value
	end
end

local function show(item: Item)
	setVisible(item, true)
end

local function hide(item: Item?)
	if item then
		setVisible(item, false)
	end
end

local function hideSquares(list: { SquareItem }?)
	if list then
		for _, item in list do
			setVisible(item, false)
		end
	end
end

local function hideLines(list: { LineItem }?)
	if list then
		for _, item in list do
			setVisible(item, false)
		end
	end
end

local function hideAll(e: Entry)
	for _, item in e.items do
		setVisible(item, false)
	end
	e.shown = false
	e.bonesShown = false
end

-- ─────────────────────────────────────────────────────────────
--  ITEM STYLES — única fonte das propriedades estáticas.
--  `fade` = opacidade relativa pelo nível de distância.
-- ─────────────────────────────────────────────────────────────
local function styleSquare(item: SquareItem, fade: number, colors: GroupColors)
	local o = item.obj
	local role = item.role
	if role == "box" then
		o.Filled = false
		o.Thickness = cfg.BoxThick
		o.Color = colors.Box
		o.Transparency = theme.boxAlpha * fade
		o.ZIndex = LAYER.Main
	elseif role == "boxOutline" then
		o.Filled = false
		o.Thickness = cfg.BoxThick + 2 * LAYOUT.OutlinePx
		o.Color = cfg.ShadowColor
		o.Transparency = theme.shadowAlpha * fade
		o.ZIndex = LAYER.Outline
	elseif role == "fill" then
		o.Filled = true
		o.Thickness = 1
		o.Color = cfg.BoxFillColor
		o.Transparency = theme.fillAlpha * fade
		o.ZIndex = LAYER.Fill
	else -- band
		o.Filled = true
		o.Thickness = 1
		o.Color = theme.bandColor[item.index]
		o.Transparency = theme.bandAlpha[item.index] * fade
		o.ZIndex = LAYER.Fill
	end
end

local function styleLine(item: LineItem, fade: number, colors: GroupColors)
	local o = item.obj
	local role = item.role
	local outline = 2 * LAYOUT.OutlinePx
	if role == "corner" then
		o.Thickness = cfg.BoxThick
		o.Color = colors.Box
		o.Transparency = theme.boxAlpha * fade
		o.ZIndex = LAYER.Main
	elseif role == "cornerOutline" then
		o.Thickness = cfg.BoxThick + outline
		o.Color = cfg.ShadowColor
		o.Transparency = theme.shadowAlpha * fade
		o.ZIndex = LAYER.Outline
	elseif role == "tracer" then
		o.Thickness = cfg.TracerThick
		o.Color = colors.Tracer
		o.Transparency = theme.tracerAlpha * fade
		o.ZIndex = LAYER.Main
	elseif role == "tracerOutline" then
		o.Thickness = cfg.TracerThick + outline
		o.Color = cfg.ShadowColor
		o.Transparency = theme.shadowAlpha * theme.tracerAlpha * fade
		o.ZIndex = LAYER.Outline
	elseif role == "hpBack" then
		o.Thickness = cfg.HealthBarWidth + outline
		o.Color = cfg.ShadowColor
		o.Transparency = theme.shadowAlpha * fade
		o.ZIndex = LAYER.Outline
	elseif role == "bone" then
		o.Thickness = cfg.BonesThick
		o.Color = colors.Bones
		o.Transparency = (1 - cfg.BonesTrans) * fade
		o.ZIndex = LAYER.Main
	else -- hpFill: a cor vem da LUT de vida em drawHealthBar
		o.Thickness = cfg.HealthBarWidth
		o.Transparency = fade
		o.ZIndex = LAYER.Main
	end
end

local function styleText(item: TextItem, fade: number)
	local o = item.obj
	local isName = item.role == "name"
	o.Size = if isName then theme.nameSize else theme.distSize
	o.Color = if isName then cfg.TextColor else cfg.DistColor
	o.Font = cfg.TextFont
	o.Center = true
	o.Outline = true
	o.OutlineColor = cfg.ShadowColor
	o.Transparency = fade
	o.ZIndex = LAYER.Text
end

local function styleItem(item: Item, fade: number, colors: GroupColors)
	if item.kind == "Square" then
		styleSquare(item, fade, colors)
	elseif item.kind == "Line" then
		styleLine(item, fade, colors)
	else
		styleText(item, fade)
	end
end

local function restyleEntry(e: Entry)
	local fade, colors = e.fade, e.colors
	for _, item in e.items do
		styleItem(item, fade, colors)
	end
	e.dirty = true
end

local function restyleAll()
	for _, e in entries do
		e.fade = fadeForTier(e.tier)
		restyleEntry(e)
	end
end

-- ─────────────────────────────────────────────────────────────
--  ITEM ACQUISITION — criação sob demanda (só o que está ligado).
-- ─────────────────────────────────────────────────────────────
local function addSquare(e: Entry, role: SquareRole, index: number): SquareItem
	local item: SquareItem = { kind = "Square", role = role, index = index, obj = takePooled(squarePool, createSquare), vis = false }
	table.insert(e.items, item) -- rastreado antes de estilizar: falha não vaza
	styleSquare(item, e.fade, e.colors)
	return item
end

local function addLine(e: Entry, role: LineRole, index: number): LineItem
	local item: LineItem = { kind = "Line", role = role, index = index, obj = takePooled(linePool, createLine), vis = false }
	table.insert(e.items, item) -- rastreado antes de estilizar: falha não vaza
	styleLine(item, e.fade, e.colors)
	return item
end

local function addText(e: Entry, role: TextRole): TextItem
	local item: TextItem = { kind = "Text", role = role, index = 0, obj = takePooled(textPool, createText), vis = false }
	table.insert(e.items, item) -- rastreado antes de estilizar: falha não vaza
	styleText(item, e.fade)
	return item
end

local function getFill(e: Entry): SquareItem
	local existing = e.fill
	if existing then return existing end
	local item = addSquare(e, "fill", 0)
	e.fill = item
	return item
end

local function getBands(e: Entry): { SquareItem }
	local existing = e.bands
	if existing then return existing end
	local list: { SquareItem } = {}
	for i = 1, FILL_BANDS do
		list[i] = addSquare(e, "band", i)
	end
	e.bands = list
	return list
end

