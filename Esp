-- Status de uma entidade. "loading" = temporário (resolvido por eventos);
-- "unsupported" = nenhum adaptador aceita a Instance; "none" = sem entidade.
type EntityStatus = "none" | "loading" | "unsupported" | "dead" | "ready"

-- FONTE: diz QUAL Instance representa o jogador. `watch` conecta os sinais
-- que indicam troca, chama `notify` quando algo muda e devolve a limpeza.
type EntitySource = {
	name: string,
	resolve: (player: Player) -> Instance?,
	watch: (player: Player, notify: () -> ()) -> (() -> ())?,
}

-- ADAPTADOR: diz COMO ler uma entidade. Só `name` e `accepts` são
-- obrigatórios; cada função omitida usa a versão genérica (ESP.Generic).
type EntityAdapter = {
	name: string,
	accepts: (entity: Instance) -> boolean,
	findAnchor: ((entity: Instance) -> Instance?)?,            -- BasePart ou Attachment
	collectParts: ((entity: Instance, out: { BasePart }) -> number)?,
	readHealth: ((entity: Instance) -> (number?, number?))?,  -- (atual, máx); nil = desconhecida
	watchHealth: ((entity: Instance, notify: () -> ()) -> (() -> ())?)?,
	-- pares { a, b } de BasePart/Attachment/Bone; tabela vazia = sem esqueleto;
	-- nil = usar a detecção automática (Motor6D → Bone)
	getSkeleton: ((entity: Instance) -> { { Instance } }?)?,
}

-- Esqueleto descoberto (estrutura). Pontos presos a peças ficam contíguos
-- por peça; pontos dinâmicos (Attachment/Bone) vêm depois.
type Skeleton = {
	kind: string,                       -- "Motor6D" | "Bone" | nome do adaptador
	parts: { BasePart },                -- uma leitura de CFrame por peça por frame
	partFirst: { number },
	partLast: { number },
	attachments: { Attachment },
	attachmentIsBone: { boolean },
	attachFirst: number,
	pointCount: number,
	offX: { number }, offY: { number }, offZ: { number },  -- offset local à peça
	segA: { number },
	segB: { number },
	segmentCount: number,
	members: { [Instance]: boolean },   -- remoção de um membro invalida na hora
}

-- Relatório de ESP.DiagnoseSkeleton: em que etapa um rig falha.
type SkeletonDiagnosis = {
	status: EntityStatus,
	rig: string?,                -- "R6" | "R15" | nil (customizado)
	humanoidRigType: string?,
	skeleton: string?,           -- tipo do esqueleto ativo (nil = nenhum)
	segments: number,
	motors: number,
	animationConstraints: number,
	bones: number,
	incompleteJoints: number,    -- juntas com Part0/Part1/Attachment ainda nil
	profileJoints: number,       -- ligações do perfil resolvidas
	profileExpected: number,
	missing: { string },         -- peças/juntas do perfil não encontradas
	bonesEnabled: boolean,
	visibleLines: number,
}

-- Estado da entidade de um jogador (camada de entidades; sem nada visual).
