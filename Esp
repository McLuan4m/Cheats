-- ─────────────────────────────────────────────────────────────
--  ADAPTADOR GENÉRICO — usado quando nenhum adaptador registrado aceita
--  a entidade e como fallback de cada função omitida num adaptador.
-- ─────────────────────────────────────────────────────────────
local function findHumanoid(entity: Instance): Humanoid?
	return entity:FindFirstChildOfClass("Humanoid") :: Humanoid?
end

-- Model, BasePart (PVInstance), Attachment ou Folder com peças dentro.
local function genericAccepts(entity: Instance): boolean
	return entity:IsA("PVInstance") or entity:IsA("Attachment") or entity:IsA("Folder")
end

-- Humanoid.RootPart → filho "HumanoidRootPart" → Model.PrimaryPart →
-- a própria entidade (BasePart/Attachment). nil: o núcleo usa a maior peça.
local function genericFindAnchor(entity: Instance): Instance?
	local hum = findHumanoid(entity)
	if hum then
		local rootPart = hum.RootPart
		if rootPart and rootPart:IsDescendantOf(entity) then
			return rootPart
		end
	end
	local named = entity:FindFirstChild(ROOT_NAME)
	if named and named:IsA("BasePart") then
		return named
	end
	if entity:IsA("Model") then
		local primary = (entity :: Model).PrimaryPart
		if primary then
			return primary
		end
	end
	if entity:IsA("BasePart") or entity:IsA("Attachment") then
		return entity
	end
	return nil
end

local function insideAccessoryOrTool(part: Instance, entity: Instance): boolean
	local accessory = part:FindFirstAncestorWhichIsA("Accoutrement")
	if accessory and accessory:IsDescendantOf(entity) then
		return true
	end
	local tool = part:FindFirstAncestorWhichIsA("Tool")
	return tool ~= nil and tool:IsDescendantOf(entity)
end

-- Todas as BaseParts descendentes (inclusive aninhadas), exceto o HRP
-- (caixa de colisão invisível) e peças de acessórios/ferramentas.
-- Hitbox: peça invisível ou com nome da lista HitboxNames. Hitboxes costumam
-- ser maiores que o corpo e deixariam a caixa grande/deslocada.
local hitboxNamesSource: string? = nil
local hitboxNames: { string } = {}
local function isHitbox(part: BasePart): boolean
	if part.Transparency >= 0.99 then
		return true
	end
	if cfg.HitboxNames ~= hitboxNamesSource then
		hitboxNamesSource = cfg.HitboxNames
		table.clear(hitboxNames)
		for name in string.gmatch(string.lower(cfg.HitboxNames), "[^,]+") do
			local trimmed = string.match(name, "^%s*(.-)%s*$")
			if trimmed and trimmed ~= "" then
				table.insert(hitboxNames, trimmed)
			end
		end
	end
	if #hitboxNames == 0 then
		return false
	end
	local lower = string.lower(part.Name)
	for _, name in hitboxNames do
		if string.find(lower, name, 1, true) then
			return true
		end
	end
	return false
end

local function genericCollectParts(entity: Instance, out: { BasePart }): number
	local n = 0
	if entity:IsA("BasePart") then
		n = 1
		out[1] = entity :: BasePart
	end
	local skipped = 0
	local ignoreHitboxes = cfg.IgnoreHitboxes
	for _, d in entity:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= ROOT_NAME then
			local part = d :: BasePart
			if insideAccessoryOrTool(part, entity) then
				continue
			end
			if ignoreHitboxes and isHitbox(part) then
				skipped += 1
				continue
			end
			n += 1
			out[n] = part
		end
	end
	if n == 0 and skipped > 0 then
		-- só havia "hitboxes" (ex.: modelo todo invisível): melhor usá-las
		-- do que ficar sem caixa
		for _, d in entity:GetDescendants() do
			if d:IsA("BasePart") and d.Name ~= ROOT_NAME and not insideAccessoryOrTool(d, entity) then
				n += 1
				out[n] = d :: BasePart
			end
		end
	end
	return n
end

-- Humanoid, se houver; senão atributos numéricos na própria entidade.
-- (nil, nil) = vida desconhecida: viva e sem barra de vida.
local function genericReadHealth(entity: Instance): (number?, number?)
	local hum = findHumanoid(entity)
	if hum then
		if hum:GetState() == Enum.HumanoidStateType.Dead then
			return 0, hum.MaxHealth
		end
		return hum.Health, hum.MaxHealth
	end
	local health = entity:GetAttribute(cfg.HealthAttribute)
	if type(health) ~= "number" then
		return nil, nil
	end
	local maxHealth = entity:GetAttribute(cfg.MaxHealthAttribute)
	return health, if type(maxHealth) == "number" then maxHealth else nil
end

local function genericWatchHealth(entity: Instance, notify: () -> ()): (() -> ())?
	local conns: { RBXScriptConnection } = {}
	local hum = findHumanoid(entity)
	if hum then
		table.insert(conns, hum.HealthChanged:Connect(notify))
		table.insert(conns, hum:GetPropertyChangedSignal("MaxHealth"):Connect(notify))
		table.insert(conns, hum.Died:Connect(notify))
	else
		table.insert(conns, entity:GetAttributeChangedSignal(cfg.HealthAttribute):Connect(notify))
		table.insert(conns, entity:GetAttributeChangedSignal(cfg.MaxHealthAttribute):Connect(notify))
	end
	return function()
		disconnectAll(conns)
	end
end

local GENERIC_ADAPTER: EntityAdapter = {
	name = "Generic",
	accepts = genericAccepts,
	findAnchor = genericFindAnchor,
	collectParts = genericCollectParts,
	readHealth = genericReadHealth,
	watchHealth = genericWatchHealth,
}

-- ─────────────────────────────────────────────────────────────
--  FONTES EMBUTIDAS — cada uma só usa APIs oficiais e é dirigida por
--  eventos. A ordem em ESP.SetEntitySources define a prioridade.
-- ─────────────────────────────────────────────────────────────

-- Player.Character (padrão; preserva o comportamento anterior).
-- CharacterRemoving oculta na hora, antes de Character mudar.
local function characterSource(): EntitySource
	local removing: { [Player]: Model } = {}
	return {
		name = "Character",
		resolve = function(player: Player): Instance?
			local char = player.Character
			if char ~= nil and removing[player] == char then
				return nil
			end
			return char
		end,
		watch = function(player: Player, notify: () -> ()): (() -> ())?
			local conns = {
				player.CharacterAdded:Connect(function()
					removing[player] = nil
					notify()
				end),
				player.CharacterRemoving:Connect(function(char: Model)
					removing[player] = char
					notify()
				end),
				player:GetPropertyChangedSignal("Character"):Connect(notify),
			}
			return function()
				removing[player] = nil
				disconnectAll(conns)
			end
		end,
	}
end

-- Veículo/assento: Humanoid.SeatPart (oficial). Entidade = Model mais
-- próximo acima do assento (ou o próprio assento). Sem assento → nil,
-- e a próxima fonte da lista decide.
local function vehicleSource(): EntitySource
	local function humanoidOf(player: Player): Humanoid?
		local char = player.Character
		return if char then findHumanoid(char) else nil
	end
	return {
		name = "Vehicle",
		resolve = function(player: Player): Instance?
			local hum = humanoidOf(player)
			local seat = if hum then hum.SeatPart else nil
			if seat == nil then
				return nil
			end
			return seat:FindFirstAncestorOfClass("Model") or seat
		end,
		watch = function(player: Player, notify: () -> ()): (() -> ())?
			local charConn: RBXScriptConnection? = nil
			local seatConn: RBXScriptConnection? = nil
			local function hookHumanoid()
				local old = seatConn
				if old then
					old:Disconnect()
				end
				local hum = humanoidOf(player)
				seatConn = if hum then hum:GetPropertyChangedSignal("SeatPart"):Connect(notify) else nil
			end
			local function hookCharacter()
				local old = charConn
				if old then
					old:Disconnect()
				end
				local char = player.Character
				-- o Humanoid pode chegar depois do Model
				charConn = if char
					then char.ChildAdded:Connect(function(child: Instance)
						if child:IsA("Humanoid") then
							hookHumanoid()
							notify()
						end
					end)
					else nil
				hookHumanoid()
			end
			local propConn = player:GetPropertyChangedSignal("Character"):Connect(function()
				hookCharacter()
				notify()
			end)
			hookCharacter()
			return function()
				propConn:Disconnect()
				local a, b = charConn, seatConn
				if a then
					a:Disconnect()
				end
				if b then
					b:Disconnect()
				end
				charConn, seatConn = nil, nil
			end
		end,
	}
end

-- Integração explícita: o jogo (servidor) mantém um ObjectValue com este
-- nome dentro do Player apontando para a entidade controlada. Filhos do
-- Player replicam para todos os clientes.
local function objectValueSource(valueName: string): EntitySource
	local function find(player: Player): ObjectValue?
		local value = player:FindFirstChild(valueName)
		if value and value:IsA("ObjectValue") then
			return value :: ObjectValue
		end
		return nil
	end
	return {
		name = "ObjectValue:" .. valueName,
		resolve = function(player: Player): Instance?
			local value = find(player)
			return if value then value.Value else nil
		end,
		watch = function(player: Player, notify: () -> ()): (() -> ())?
			local valueConn: RBXScriptConnection? = nil
			local function hook()
				local old = valueConn
				if old then
					old:Disconnect()
				end
				local value = find(player)
				valueConn = if value then value:GetPropertyChangedSignal("Value"):Connect(notify) else nil
			end
			local function onChild(child: Instance)
				if child.Name == valueName then
					hook()
					notify()
				end
			end
			local added = player.ChildAdded:Connect(onChild)
			local removed = player.ChildRemoved:Connect(onChild)
			hook()
			return function()
				added:Disconnect()
				removed:Disconnect()
				local old = valueConn
				if old then
					old:Disconnect()
				end
				valueConn = nil
			end
		end,
	}
end

-- ─────────────────────────────────────────────────────────────
--  TRACKER — estado da entidade de um jogador. Funções de integração
--  (fontes/adaptadores do usuário) sempre rodam protegidas por pcall.
-- ─────────────────────────────────────────────────────────────
local function newTracker(player: Player): Tracker
	return {
		player = player,
		destroyed = false,
		sourceCleanups = {},
		entityConns = {},
		structureDirty = false,
		skeletonDirty = true,
		skeletonConns = {},
		parts = {},
		partCount = 0,
		hasBounds = false,
		boundsDueAt = 0,
		offX = 0, offY = 0, offZ = 0,
		halfX = 1, halfY = 1, halfZ = 1,
		inWorld = false,
		alive = true,
		status = "none",
		ready = false,
		revision = 0,
	}
end

-- Único ponto que decide o status. "loading" é recuperável por eventos;
-- "unsupported" só muda se a entidade ou os adaptadores mudarem.
local function evaluate(t: Tracker)
	local status: EntityStatus
	local reason: string? = nil
	if t.entity == nil then
		status = "none"
	elseif t.adapter == nil then
		status = "unsupported"
	elseif not t.inWorld then
		status, reason = "loading", "outOfWorld"
	elseif t.anchorPart == nil and t.anchorAttachment == nil then
		status, reason = "loading", "noReference"
	elseif not t.hasBounds then
		status, reason = "loading", "noBounds"
	elseif not t.alive then
		status = "dead"
	else
		status = "ready"
	end
	if status ~= t.status or reason ~= t.reason then
		t.status = status
		t.reason = reason
		t.ready = status == "ready"
		t.revision += 1
	end
end

local function pickAdapter(entity: Instance): EntityAdapter?
	for _, adapter in adapters do
		local ok, accepted = pcall(adapter.accepts, entity)
		if not ok then
			reportError("adaptador " .. adapter.name .. ".accepts", accepted)
		elseif accepted then
			return adapter
		end
	end
	return if genericAccepts(entity) then GENERIC_ADAPTER else nil
end

local function readTrackerHealth(t: Tracker)
	local entity, adapter = t.entity, t.adapter
	if entity == nil or adapter == nil then
		return
	end
	local ok, health, maxHealth = pcall(adapter.readHealth or genericReadHealth, entity)
	if not ok then
		reportError("adaptador " .. adapter.name .. ".readHealth", health)
		health, maxHealth = nil, nil
	end
	local alive = true
	local hp01: number? = nil
	if type(health) == "number" then
		alive = health > 0
		if type(maxHealth) == "number" and maxHealth > 0 then
			hp01 = math.clamp(health / maxHealth, 0, 1)
		end
	end
	if alive ~= t.alive or hp01 ~= t.hp01 then
		t.alive = alive
		t.hp01 = hp01
		t.revision += 1
	end
	evaluate(t)
end

local function rebindHealth(t: Tracker, hum: Humanoid?)
	local cleanup = t.healthCleanup
	t.healthCleanup = nil
	if cleanup then
		local ok, err = pcall(cleanup)
		if not ok then
			reportError("limpeza de vida", err)
		end
	end
	t.healthHumanoid = hum
	local entity, adapter = t.entity, t.adapter
	if entity == nil or adapter == nil then
		return
	end
	local notify = guard("health", function()
		if not t.destroyed and t.entity == entity then
			readTrackerHealth(t)
		end
	end)
	local ok, result = pcall(adapter.watchHealth or genericWatchHealth, entity, notify)
	if not ok then
		reportError("adaptador " .. adapter.name .. ".watchHealth", result)
	elseif type(result) == "function" then
		t.healthCleanup = result
	end
	readTrackerHealth(t)
end

-- A âncora só é aceita se pertencer à entidade (nunca uma peça de fora).
local function setAnchor(t: Tracker, anchor: Instance?)
	local part: BasePart? = nil
	local attachment: Attachment? = nil
	local entity = t.entity
	if anchor and entity and (anchor == entity or anchor:IsDescendantOf(entity)) then
		if anchor:IsA("BasePart") then
			part = anchor :: BasePart
		elseif anchor:IsA("Attachment") then
			attachment = anchor :: Attachment
		end
	end
	if part ~= t.anchorPart or attachment ~= t.anchorAttachment then
		t.anchorPart = part
		t.anchorAttachment = attachment
		t.hasBounds = false -- limites são relativos à âncora
		t.revision += 1
	end
end

local volumeScratch: { [BasePart]: number } = {}
local function largerFirst(a: BasePart, b: BasePart): boolean
	return volumeScratch[a] > volumeScratch[b]
end

local function collectParts(t: Tracker, entity: Instance, adapter: EntityAdapter)
	local parts = t.parts
	table.clear(parts)
	local n = 0
	local custom = adapter.collectParts
	if custom and custom ~= genericCollectParts then
		local ok, result = pcall(custom, entity, parts)
		if not ok then
			reportError("adaptador " .. adapter.name .. ".collectParts", result)
		end
		-- valida o que veio de fora: só BaseParts que pertencem à entidade
		local count = if ok and type(result) == "number" then math.floor(result) else 0
		for i = 1, math.min(count, #parts) do
			local p = parts[i]
			if typeof(p) == "Instance" and p:IsA("BasePart") and ((p :: Instance) == entity or p:IsDescendantOf(entity)) then
				n += 1
				parts[n] = p
			end
		end
		for i = #parts, n + 1, -1 do
			parts[i] = nil
		end
	else
		n = genericCollectParts(entity, parts)
	end

	-- modelos enormes: limites pelas maiores peças (custo por atualização limitado)
	local cap = TUNING.MaxBoundsParts
	if n > cap then
		for i = 1, n do
			local size = parts[i].Size
			volumeScratch[parts[i]] = size.X * size.Y * size.Z
		end
		table.sort(parts, largerFirst)
		table.clear(volumeScratch)
		for i = cap + 1, n do
			parts[i] = nil
		end
		n = cap
	end
	t.partCount = n
end

local function largestPart(t: Tracker): BasePart?
	local best: BasePart? = nil
	local bestVolume = -1
	for i = 1, t.partCount do
		local part = t.parts[i]
		local size = part.Size
		local volume = size.X * size.Y * size.Z
		if volume > bestVolume then
			best, bestVolume = part, volume
		end
	end
	return best
end

local function anchorCFrame(t: Tracker): CFrame?
	local part = t.anchorPart
	if part then
		return part.CFrame
	end
	local attachment = t.anchorAttachment
	return if attachment then attachment.WorldCFrame else nil
end

-- AABB no espaço local da âncora. Extensão de cada peça por eixo =
-- Σ|R_ij|·meia-dimensão (sem enumerar 8 cantos).
local function computeBounds(t: Tracker): boolean
	local anchorCF = anchorCFrame(t)
	if anchorCF == nil then
		return false
	end
	local count = t.partCount
	if count == 0 then
		-- sem peças: tamanho da própria âncora, ou um marcador de PointSize
		local part = t.anchorPart
		local hx, hy, hz
		if part then
			local size = part.Size
			hx, hy, hz = size.X * 0.5, size.Y * 0.5, size.Z * 0.5
		else
			local half = cfg.PointSize * 0.5
			hx, hy, hz = half, half, half
		end
		t.offX, t.offY, t.offZ = 0, 0, 0
		t.halfX, t.halfY, t.halfZ = hx, hy, hz
		return true
	end

	local parts = t.parts
	local minX, minY, minZ = math.huge, math.huge, math.huge
	local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
	for i = 1, count do
		local part = parts[i]
		local size = part.Size
		local hx, hy, hz = size.X * 0.5, size.Y * 0.5, size.Z * 0.5
		local x, y, z, m00, m01, m02, m10, m11, m12, m20, m21, m22 =
			anchorCF:ToObjectSpace(part.CFrame):GetComponents()
		local ex = math.abs(m00) * hx + math.abs(m01) * hy + math.abs(m02) * hz
		local ey = math.abs(m10) * hx + math.abs(m11) * hy + math.abs(m12) * hz
		local ez = math.abs(m20) * hx + math.abs(m21) * hy + math.abs(m22) * hz
		if x - ex < minX then minX = x - ex end
		if x + ex > maxX then maxX = x + ex end
		if y - ey < minY then minY = y - ey end
		if y + ey > maxY then maxY = y + ey end
		if z - ez < minZ then minZ = z - ez end
		if z + ez > maxZ then maxZ = z + ez end
	end
	t.offX, t.offY, t.offZ = (minX + maxX) * 0.5, (minY + maxY) * 0.5, (minZ + maxZ) * 0.5
	t.halfX, t.halfY, t.halfZ = (maxX - minX) * 0.5, (maxY - minY) * 0.5, (maxZ - minZ) * 0.5
	return true
end

local function updateBounds(t: Tracker)
	t.hasBounds = computeBounds(t)
	evaluate(t)
end

-- Reavalia adaptador, peças, âncora e vínculo de vida. Chamado no bind
-- e (com orçamento) pelo loop pesado quando a estrutura mudou.
local function refreshStructure(t: Tracker)
	t.structureDirty = false
	local entity = t.entity
	if entity == nil then
		return
	end
	local adapter = pickAdapter(entity)
	local adapterChanged = adapter ~= t.adapter
	t.adapter = adapter
	if adapter == nil then
		setAnchor(t, nil)
		table.clear(t.parts)
		t.partCount = 0
		rebindHealth(t, nil)
		evaluate(t)
		return
	end

	collectParts(t, entity, adapter)
	local ok, anchor = pcall(adapter.findAnchor or genericFindAnchor, entity)
	if not ok then
		reportError("adaptador " .. adapter.name .. ".findAnchor", anchor)
		anchor = nil
	end
	if anchor == nil then
		anchor = largestPart(t)
	end
	setAnchor(t, anchor)

	local hum = findHumanoid(entity)
	if adapterChanged or hum ~= t.healthHumanoid or t.healthCleanup == nil then
		rebindHealth(t, hum)
	end
	updateBounds(t)
end

-- ─────────────────────────────────────────────────────────────
--  ESQUELETO (descoberta) — roda só quando a estrutura muda e Bones está
--  ligado. Nunca conecta peças por proximidade: as ligações vêm de um
--  adaptador, do perfil R6/R15, das juntas do rig (Motor6D ou
--  AnimationConstraint) ou da hierarquia de Bone.
-- ─────────────────────────────────────────────────────────────

-- Só `discoverSkeleton` sai do bloco (limite de 200 locais do chunk principal).
local discoverSkeleton: (t: Tracker) -> ()
local diagnoseSkeleton: (t: Tracker) -> SkeletonDiagnosis
do
	-- Rascunho de ponto (existe só durante a descoberta).
	type JointDraft = {
		part: BasePart?,          -- ponto preso a uma peça: CFrame da peça * offset
		attachment: Attachment?,  -- ou ponto dinâmico (Attachment/Bone)
		isBone: boolean,
		ox: number, oy: number, oz: number,
	}

	type SkeletonBuilder = {
		drafts: { JointDraft },
		segA: { number },
		segB: { number },
		members: { [Instance]: boolean },
	}

	local function newSkeletonBuilder(): SkeletonBuilder
		return { drafts = {}, segA = {}, segB = {}, members = {} }
	end

	local function addJoint(b: SkeletonBuilder, part: BasePart?, attachment: Attachment?, isBone: boolean, ox: number, oy: number, oz: number): number
		table.insert(b.drafts, { part = part, attachment = attachment, isBone = isBone, ox = ox, oy = oy, oz = oz })
		if part then
			b.members[part] = true
		end
		if attachment then
			b.members[attachment] = true
		end
		return #b.drafts
	end

	local function addSegment(b: SkeletonBuilder, a: number, c: number)
		if a ~= c then
			table.insert(b.segA, a)
			table.insert(b.segB, c)
		end
	end

	-- Reordena os pontos: os de cada peça ficam contíguos (uma leitura de CFrame
	-- por peça por frame); pontos dinâmicos vêm depois. nil se não há ligações.
	local function finalizeSkeleton(b: SkeletonBuilder, kind: string): Skeleton?
		local segmentCount = math.min(#b.segA, TUNING.MaxBones)
		if segmentCount == 0 then
			return nil
		end
		local drafts = b.drafts
		local parts: { BasePart } = {}
		local bucket: { [BasePart]: { number } } = {}
		local attachmentDrafts: { number } = {}
		for i, d in drafts do
			local part = d.part
			if part then
				local list = bucket[part]
				if list == nil then
					list = {}
					bucket[part] = list
					table.insert(parts, part)
				end
				table.insert(list, i)
			else
				table.insert(attachmentDrafts, i)
			end
		end

		local skel: Skeleton = {
			kind = kind,
			parts = parts,
			partFirst = {},
			partLast = {},
			attachments = {},
			attachmentIsBone = {},
			attachFirst = 0,
			pointCount = #drafts,
			offX = {}, offY = {}, offZ = {},
			segA = {},
			segB = {},
			segmentCount = segmentCount,
			members = b.members,
		}
		local remap: { number } = {}
		local n = 0
		for s, part in parts do
			skel.partFirst[s] = n + 1
			for _, i in bucket[part] do
				n += 1
				remap[i] = n
				local d = drafts[i]
				skel.offX[n], skel.offY[n], skel.offZ[n] = d.ox, d.oy, d.oz
			end
			skel.partLast[s] = n
		end
		skel.attachFirst = n + 1
		for _, i in attachmentDrafts do
			n += 1
			remap[i] = n
			local d = drafts[i]
			table.insert(skel.attachments, d.attachment :: Attachment)
			table.insert(skel.attachmentIsBone, d.isBone)
		end
		for k = 1, segmentCount do
			skel.segA[k] = remap[b.segA[k]]
			skel.segB[k] = remap[b.segB[k]]
		end
		return skel
	end

	-- Ponta de um membro terminal: face oposta à junta, no eixo mais longo da
	-- peça (ou, se a junta está no meio desse eixo, no eixo em que está mais
	-- perto de uma face — ex.: cabeça R6, mais larga que alta).
	local function leafEndOffset(size: Vector3, jx: number, jy: number, jz: number): (number, number, number)
		local half = { size.X * 0.5, size.Y * 0.5, size.Z * 0.5 }
		local joint = { jx, jy, jz }
		local axis = if half[1] >= half[2] and half[1] >= half[3] then 1 elseif half[2] >= half[3] then 2 else 3
		if math.abs(joint[axis]) < 0.1 * half[axis] then
			local best = -1
			for a = 1, 3 do
				local ratio = if half[a] > 0 then math.abs(joint[a]) / half[a] else 0
				if ratio > best then
					best, axis = ratio, a
				end
			end
		end
		local out = { 0, 0, 0 }
		out[axis] = if joint[axis] > 0 then -half[axis] else half[axis]
		return out[1], out[2], out[3]
	end

	local function skeletonPart(part: BasePart?, entity: Instance, hiddenRoot: BasePart?): boolean
		if part == nil or part == hiddenRoot or part.Name == ROOT_NAME then
			return false
		end
		if (part :: Instance) ~= entity and not part:IsDescendantOf(entity) then
			return false
		end
		return not insideAccessoryOrTool(part, entity)
	end

	-- Junta física normalizada: Motor6D (C0/C1) ou AnimationConstraint
	-- (Attachment0/1 — usado pelo Avatar Joint Upgrade do R15), com a posição
	-- da junta no espaço de cada peça. O construtor do grafo só vê isto.
	type JointSpec = {
		name: string,
		part0: BasePart,
		part1: BasePart,
		x0: number, y0: number, z0: number,  -- junta no espaço de part0
		x1: number, y1: number, z1: number,  -- junta no espaço de part1
		source: Instance,                    -- Motor6D, AnimationConstraint ou RigAttachment
		att0: Attachment?,                   -- attachments usados (invalidação se removidos)
		att1: Attachment?,
	}

	type JointScan = {
		motors: number,
		constraints: number,
		bones: { Bone },
		joints: { JointSpec },               -- juntas completas e válidas
		incomplete: { Instance },            -- referências ainda nil (ordem de replicação)
	}

	local function attachmentPart(att: Attachment?): BasePart?
		local parent = if att then att.Parent else nil
		if parent and parent:IsA("BasePart") then
			return parent :: BasePart
		end
		return nil
	end

	local function jointFromAttachments(name: string, a0: Attachment, a1: Attachment, p0: BasePart, p1: BasePart, source: Instance): JointSpec
		local c0, c1 = a0.CFrame.Position, a1.CFrame.Position
		return {
			name = name, part0 = p0, part1 = p1,
			x0 = c0.X, y0 = c0.Y, z0 = c0.Z,
			x1 = c1.X, y1 = c1.Y, z1 = c1.Z,
			source = source, att0 = a0, att1 = a1,
		}
	end

	-- Uma varredura de descendentes por descoberta.
	local function scanJoints(entity: Instance, hiddenRoot: BasePart?): JointScan
		local scan: JointScan = { motors = 0, constraints = 0, bones = {}, joints = {}, incomplete = {} }
		for _, d in entity:GetDescendants() do
			if d:IsA("Motor6D") then
				local motor = d :: Motor6D
				scan.motors += 1
				local p0, p1 = motor.Part0, motor.Part1
				if p0 == nil or p1 == nil then
					table.insert(scan.incomplete, motor)
				elseif motor.Enabled and skeletonPart(p0, entity, hiddenRoot) and skeletonPart(p1, entity, hiddenRoot) then
					local c0, c1 = motor.C0.Position, motor.C1.Position
					table.insert(scan.joints, {
						name = motor.Name, part0 = p0, part1 = p1,
						x0 = c0.X, y0 = c0.Y, z0 = c0.Z,
						x1 = c1.X, y1 = c1.Y, z1 = c1.Z,
						source = motor,
					})
				end
			elseif d:IsA("AnimationConstraint") then
				local constraint = d :: AnimationConstraint
				scan.constraints += 1
				local a0, a1 = constraint.Attachment0, constraint.Attachment1
				local p0, p1 = attachmentPart(a0), attachmentPart(a1)
				if a0 == nil or a1 == nil or p0 == nil or p1 == nil then
					table.insert(scan.incomplete, constraint)
				elseif constraint.Enabled and skeletonPart(p0, entity, hiddenRoot) and skeletonPart(p1, entity, hiddenRoot) then
					table.insert(scan.joints, jointFromAttachments(constraint.Name, a0, a1, p0, p1, constraint))
				end
			elseif d:IsA("Bone") then
				table.insert(scan.bones, d :: Bone)
			end
		end
		return scan
	end

	-- Grafo de juntas (o mesmo para R6, R15 e rigs customizados). Cada junta
	-- vira um ponto (preso a Part0); dentro de cada peça liga-se a junta de
	-- entrada às de saída (pelo centro, se forem várias). Peça sem entrada =
	-- centro como hub; sem saída = ponta.
	local function buildJointSkeleton(joints: { JointSpec }, kind: string): Skeleton?
		local b = newSkeletonBuilder()
		local incoming: { [BasePart]: number } = {}
		local incomingSpec: { [BasePart]: JointSpec } = {}
		local outgoing: { [BasePart]: { number } } = {}
		local order: { BasePart } = {}
		local seen: { [BasePart]: boolean } = {}
		for _, j in joints do
			local p0, p1 = j.part0, j.part1
			if incoming[p1] == nil then
				local joint = addJoint(b, p0, nil, false, j.x0, j.y0, j.z0)
				b.members[j.source] = true
				local att0, att1 = j.att0, j.att1
				if att0 then
					b.members[att0] = true
				end
				if att1 then
					b.members[att1] = true
				end
				incoming[p1] = joint
				incomingSpec[p1] = j
				local outs = outgoing[p0]
				if outs == nil then
					outs = {}
					outgoing[p0] = outs
				end
				table.insert(outs, joint)
				for _, part in { p0, p1 } do
					if not seen[part] then
						seen[part] = true
						table.insert(order, part)
					end
				end
			end
		end
		for _, part in order do
			local inPoint = incoming[part]
			local outs = outgoing[part]
			if inPoint and outs and #outs == 1 then
				addSegment(b, inPoint, outs[1])
			elseif inPoint and outs then
				-- vários filhos (ex.: tronco → pescoço e ombros): passa pelo centro,
				-- formando a coluna em vez de um "V" da cintura aos ombros
				local center = addJoint(b, part, nil, false, 0, 0, 0)
				addSegment(b, inPoint, center)
				for _, o in outs do
					addSegment(b, center, o)
				end
			elseif inPoint then
				local j = incomingSpec[part]
				local ex, ey, ez = leafEndOffset(part.Size, j.x1, j.y1, j.z1)
				addSegment(b, inPoint, addJoint(b, part, nil, false, ex, ey, ez))
			elseif outs then
				local center = addJoint(b, part, nil, false, 0, 0, 0)
				for _, o in outs do
					addSegment(b, center, o)
				end
			end
		end
		return finalizeSkeleton(b, kind)
	end

	-- Perfis dos rigs padrão: ligações reais de cada rig (nomes do Roblox).
	-- {junta, Part0, Part1}; a raiz (HumanoidRootPart) fica de fora. Um perfil
	-- só é aplicado ao rig dele — nunca R6 em R15 ou vice-versa.
	local RIG_PROFILES: { [string]: { { string } } } = {
		R6 = {
			{ "Neck", "Torso", "Head" },
			{ "Left Shoulder", "Torso", "Left Arm" },
			{ "Right Shoulder", "Torso", "Right Arm" },
			{ "Left Hip", "Torso", "Left Leg" },
			{ "Right Hip", "Torso", "Right Leg" },
		},
		R15 = {
			{ "Waist", "LowerTorso", "UpperTorso" },
			{ "Neck", "UpperTorso", "Head" },
			{ "LeftShoulder", "UpperTorso", "LeftUpperArm" },
			{ "LeftElbow", "LeftUpperArm", "LeftLowerArm" },
			{ "LeftWrist", "LeftLowerArm", "LeftHand" },
			{ "RightShoulder", "UpperTorso", "RightUpperArm" },
			{ "RightElbow", "RightUpperArm", "RightLowerArm" },
			{ "RightWrist", "RightLowerArm", "RightHand" },
			{ "LeftHip", "LowerTorso", "LeftUpperLeg" },
			{ "LeftKnee", "LeftUpperLeg", "LeftLowerLeg" },
			{ "LeftAnkle", "LeftLowerLeg", "LeftFoot" },
			{ "RightHip", "LowerTorso", "RightUpperLeg" },
			{ "RightKnee", "RightUpperLeg", "RightLowerLeg" },
			{ "RightAnkle", "RightLowerLeg", "RightFoot" },
		},
	}

	local function childPart(entity: Instance, name: string): BasePart?
		local child = entity:FindFirstChild(name)
		if child and child:IsA("BasePart") then
			return child :: BasePart
		end
		return nil
	end

	-- R6/R15 exige as peças-âncora com os nomes reais; Humanoid.RigType, se
	-- existir, precisa concordar (senão é tratado como rig customizado).
	local function detectRig(entity: Instance, hum: Humanoid?): string?
		local byNames: string? = nil
		if childPart(entity, "UpperTorso") and childPart(entity, "LowerTorso") then
			byNames = "R15"
		elseif childPart(entity, "Torso") then
			byNames = "R6"
		end
		if byNames and hum then
			local expected = if byNames == "R15" then Enum.HumanoidRigType.R15 else Enum.HumanoidRigType.R6
			if hum.RigType ~= expected then
				return nil
			end
		end
		return byNames
	end

	-- Resolve cada ligação do perfil: junta física entre as duas peças
	-- (Motor6D/AnimationConstraint) → "<Junta>RigAttachment" nas duas peças
	-- (R15 real; independe de Part0/Part1) → ausente (ignorada com segurança).
	local function profileJoints(entity: Instance, rig: string, scan: JointScan, missing: { string }?): { JointSpec }
		local byPart1: { [BasePart]: JointSpec } = {}
		for _, j in scan.joints do
			byPart1[j.part1] = j
		end
		local out: { JointSpec } = {}
		for _, spec in RIG_PROFILES[rig] do
			local name, p0, p1 = spec[1], childPart(entity, spec[2]), childPart(entity, spec[3])
			if p0 and p1 then
				local physical = byPart1[p1]
				if physical and physical.part0 == p0 then
					table.insert(out, physical)
				else
					local a0 = p0:FindFirstChild(name .. "RigAttachment")
					local a1 = p1:FindFirstChild(name .. "RigAttachment")
					if a0 and a1 and a0:IsA("Attachment") and a1:IsA("Attachment") then
						table.insert(out, jointFromAttachments(name, a0 :: Attachment, a1 :: Attachment, p0, p1, a0))
					elseif missing then
						table.insert(missing, name)
					end
				end
			elseif missing then
				table.insert(missing, if p0 == nil then spec[2] else spec[3])
			end
		end
		return out
	end

	-- Junta com referência nil (ainda replicando): observa só essas
	-- propriedades e pede nova descoberta quando forem preenchidas.
	local function watchIncomplete(t: Tracker, entity: Instance, incomplete: { Instance })
		local conns = t.skeletonConns
		local function onChanged()
			if t.entity == entity then
				t.skeletonDirty = true
			end
		end
		for _, inst in incomplete do
			local a, b = if inst:IsA("Motor6D") then "Part0" else "Attachment0", if inst:IsA("Motor6D") then "Part1" else "Attachment1"
			table.insert(conns, inst:GetPropertyChangedSignal(a):Connect(onChanged))
			table.insert(conns, inst:GetPropertyChangedSignal(b):Connect(onChanged))
		end
	end

	-- Hierarquia de Bone (malhas com skinning): Bone pai → Bone filho.
	local function buildBoneSkeleton(entity: Instance, bones: { Bone }): Skeleton?
		local b = newSkeletonBuilder()
		local pointOf: { [Bone]: number } = {}
		for _, bone in bones do
			local parent = bone.Parent
			if parent and parent:IsA("Bone") and not insideAccessoryOrTool(bone, entity) then
				local parentBone = parent :: Bone
				local a = pointOf[parentBone]
				if a == nil then
					a = addJoint(b, nil, parentBone, true, 0, 0, 0)
					pointOf[parentBone] = a
				end
				local c = pointOf[bone]
				if c == nil then
					c = addJoint(b, nil, bone, true, 0, 0, 0)
					pointOf[bone] = c
				end
				addSegment(b, a, c)
			end
		end
		return finalizeSkeleton(b, "Bone")
	end

	-- Pares {a, b} fornecidos por um adaptador. Cada ponta deve ser BasePart
	-- (centro), Attachment ou Bone da própria entidade; pares inválidos são
	-- ignorados (nunca se inventa uma ligação).
	local function buildPairSkeleton(entity: Instance, pairs: { unknown }, kind: string): Skeleton?
		local b = newSkeletonBuilder()
		local pointOf: { [Instance]: number } = {}
		local function pointFor(value: unknown): number?
			if typeof(value) ~= "Instance" then
				return nil
			end
			local inst = value :: Instance
			if inst ~= entity and not inst:IsDescendantOf(entity) then
				return nil
			end
			local existing = pointOf[inst]
			if existing then
				return existing
			end
			local index: number? = nil
			if inst:IsA("BasePart") then
				index = addJoint(b, inst :: BasePart, nil, false, 0, 0, 0)
			elseif inst:IsA("Attachment") then
				index = addJoint(b, nil, inst :: Attachment, inst:IsA("Bone"), 0, 0, 0)
			end
			if index then
				pointOf[inst] = index
			end
			return index
		end
		for _, pair in pairs do
			if type(pair) == "table" then
				local ends = pair :: { unknown }
				local a, c = pointFor(ends[1]), pointFor(ends[2])
				if a and c then
					addSegment(b, a, c)
				end
			end
		end
		return finalizeSkeleton(b, kind)
	end

	-- Adaptador.getSkeleton (tabela = decisão explícita, inclusive vazia) →
	-- perfil R6/R15 (detectado automaticamente) → grafo de juntas do próprio
	-- rig (customizados) → hierarquia de Bone. Uma varredura por descoberta.
	discoverSkeleton = function(t: Tracker)
		disconnectAll(t.skeletonConns)
		t.skeletonDirty = false
		t.skeleton = nil
		local entity, adapter = t.entity, t.adapter
		if entity == nil or adapter == nil then
			return
		end
		local custom = adapter.getSkeleton
		if custom then
			local ok, result = pcall(custom, entity)
			if not ok then
				reportError("adaptador " .. adapter.name .. ".getSkeleton", result)
				return
			end
			if type(result) == "table" then
				t.skeleton = buildPairSkeleton(entity, result :: { unknown }, adapter.name)
				return
			end
		end
		local hum = t.healthHumanoid
		local hiddenRoot = if hum then hum.RootPart else nil
		local scan = scanJoints(entity, hiddenRoot)
		watchIncomplete(t, entity, scan.incomplete)
		local rig = detectRig(entity, hum)
		if rig then
			t.skeleton = buildJointSkeleton(profileJoints(entity, rig, scan, nil), rig)
			if t.skeleton then
				return
			end
		end
		t.skeleton = (if #scan.joints > 0 then buildJointSkeleton(scan.joints, "Joints") else nil)
			or (if #scan.bones > 0 then buildBoneSkeleton(entity, scan.bones) else nil)
	end

	-- Diagnóstico sob demanda (custo zero se não for chamado): mostra em
	-- que etapa um rig falha. Mesma lógica da descoberta, sem alterar estado.
	diagnoseSkeleton = function(t: Tracker): SkeletonDiagnosis
		local entity = t.entity
		local hum = t.healthHumanoid
		local report: SkeletonDiagnosis = {
			status = t.status,
			rig = nil,
			humanoidRigType = if hum then hum.RigType.Name else nil,
			skeleton = if t.skeleton then t.skeleton.kind else nil,
			segments = if t.skeleton then t.skeleton.segmentCount else 0,
			motors = 0,
			animationConstraints = 0,
			bones = 0,
			incompleteJoints = 0,
			profileJoints = 0,
			profileExpected = 0,
			missing = {},
			bonesEnabled = cfg.Bones,
			visibleLines = 0,
		}
		if entity == nil then
			return report
		end
		local scan = scanJoints(entity, if hum then hum.RootPart else nil)
		report.motors = scan.motors
		report.animationConstraints = scan.constraints
		report.bones = #scan.bones
		report.incompleteJoints = #scan.incomplete
		local rig = detectRig(entity, hum)
		report.rig = rig
		if rig then
			report.profileExpected = #RIG_PROFILES[rig]
			report.profileJoints = #profileJoints(entity, rig, scan, report.missing)
		end
		return report
	end
end

local function unbindEntity(t: Tracker)
	disconnectAll(t.entityConns)
	local cleanup = t.healthCleanup
	t.healthCleanup = nil
	if cleanup then
		local ok, err = pcall(cleanup)
		if not ok then
			reportError("limpeza de vida", err)
		end
	end
	t.entity = nil
	t.adapter = nil
	t.healthHumanoid = nil
	t.highlightTarget = nil
	t.anchorPart = nil
	t.anchorAttachment = nil
	table.clear(t.parts)
	t.partCount = 0
	t.hasBounds = false
	t.structureDirty = false
	t.boundsDueAt = 0
	t.inWorld = false
	t.alive = true
	t.hp01 = nil
	t.skeleton = nil
	t.skeletonDirty = true
	disconnectAll(t.skeletonConns)
	t.revision += 1
end

local resolveAndBind: (t: Tracker) -> ()

local function relevantDescendant(inst: Instance): boolean
	return inst:IsA("BasePart") or inst:IsA("Humanoid") or inst:IsA("Attachment")
end

local function bindEntity(t: Tracker, entity: Instance?, sourceName: string?)
	unbindEntity(t)
	t.sourceName = sourceName
	if entity == nil then
		evaluate(t)
		return
	end
	t.entity = entity
	local adapter = pickAdapter(entity)
	t.adapter = adapter
	if adapter == nil then
		if t.warnedEntity ~= entity then
			t.warnedEntity = entity
			warn(string.format(
				"[ESP] entidade não suportada para %s: %s (%s), fonte %s",
				t.player.Name, entity.Name, entity.ClassName, tostring(sourceName)
			))
		end
		evaluate(t)
		return
	end

	t.inWorld = entity:IsDescendantOf(workspace)
	t.highlightTarget = if entity:IsA("Model") or entity:IsA("BasePart") then entity else nil

	local conns = t.entityConns
	table.insert(conns, entity.AncestryChanged:Connect(guard("entityAncestry", function()
		if t.entity ~= entity then
			return
		end
		local inWorld = entity:IsDescendantOf(workspace)
		if inWorld ~= t.inWorld then
			t.inWorld = inWorld
			if inWorld then
				t.structureDirty = true -- pode ter mudado enquanto fora (streaming)
			end
			evaluate(t)
		end
	end)))
	-- mudanças estruturais só marcam sujo; o loop pesado reprocessa com orçamento
	table.insert(conns, entity.DescendantAdded:Connect(guard("entityDescendantAdded", function(inst: Instance)
		if t.entity ~= entity then
			return
		end
		if relevantDescendant(inst) then
			-- peça/attachment novos podem completar o rig (R15 montado aos poucos,
			-- peças trocadas por HumanoidDescription, RigAttachments tardios)
			t.structureDirty = true
			t.skeletonDirty = true
		elseif inst:IsA("Motor6D") or inst:IsA("AnimationConstraint") then
			t.skeletonDirty = true
		end
	end)))
	table.insert(conns, entity.DescendantRemoving:Connect(guard("entityDescendantRemoving", function(inst: Instance)
		if t.entity ~= entity then
			return
		end
		-- membro do esqueleto saindo: invalida já (nunca desenhar com peça removida)
		local skel = t.skeleton
		if skel and skel.members[inst] then
			t.skeleton = nil
			t.skeletonDirty = true
		elseif inst:IsA("Motor6D") or inst:IsA("AnimationConstraint") then
			t.skeletonDirty = true
		end
		if not relevantDescendant(inst) then
			return
		end
		t.structureDirty = true
		local anchor: Instance? = t.anchorPart or t.anchorAttachment
		if anchor and (anchor == inst or anchor:IsDescendantOf(inst)) then
			setAnchor(t, nil) -- reação imediata: nunca desenhar com âncora removida
			evaluate(t)
		end
	end)))
	table.insert(conns, entity.Destroying:Connect(guard("entityDestroying", function()
		if t.destroyed or t.entity ~= entity then
			return
		end
		t.lastDestroyed = entity
		if overrides[t.player] == entity then
			overrides[t.player] = nil
		end
		resolveAndBind(t)
	end)))
	if entity:IsA("Model") then
		table.insert(conns, entity:GetPropertyChangedSignal("PrimaryPart"):Connect(guard("primaryPart", function()
			if t.entity == entity then
				t.structureDirty = true
			end
		end)))
	end

	refreshStructure(t)
end

-- Override manual → fontes na ordem configurada. Uma entidade destruída
-- nunca é reaproveitada (ex.: Character ainda aponta para o modelo antigo).
local function resolveEntity(t: Tracker): (Instance?, string?)
	local player = t.player
	local override = overrides[player]
	if override ~= nil and override ~= t.lastDestroyed then
		return override, "override"
	end
	for _, source in entitySources do
		local ok, entity = pcall(source.resolve, player)
		if not ok then
			reportError("fonte " .. source.name .. ".resolve", entity)
		elseif entity ~= nil and entity ~= t.lastDestroyed then
			if typeof(entity) == "Instance" then
				return entity, source.name
			end
			reportError("fonte " .. source.name .. ".resolve", "retornou " .. typeof(entity) .. ", esperado Instance")
		end
	end
	return nil, nil
end

resolveAndBind = function(t: Tracker)
	if t.destroyed then
		return
	end
	local entity, sourceName = resolveEntity(t)
	if entity ~= t.entity then
		bindEntity(t, entity, sourceName)
	else
		t.sourceName = sourceName
	end
end

local function unwatchSources(t: Tracker)
	local cleanups = t.sourceCleanups
	for i = #cleanups, 1, -1 do
		local ok, err = pcall(cleanups[i])
		if not ok then
			reportError("limpeza de fonte", err)
		end
		cleanups[i] = nil
	end
end

local function watchSources(t: Tracker)
	unwatchSources(t)
	local notify = guard("entitySource", function()
		resolveAndBind(t)
	end)
	for _, source in entitySources do
		local ok, cleanup = pcall(source.watch, t.player, notify)
		if not ok then
			reportError("fonte " .. source.name .. ".watch", cleanup)
		elseif type(cleanup) == "function" then
			table.insert(t.sourceCleanups, cleanup)
		end
	end
end

local function disposeTracker(t: Tracker)
	t.destroyed = true
	unwatchSources(t)
	unbindEntity(t)
	t.lastDestroyed = nil
	t.warnedEntity = nil
end

-- ═════════════════════════════════════════════════════════════
--  CAMADA VISUAL — Highlight (Instance oficial; o motor renderiza no
--  máx. 31). Lê só o Tracker: alvo, prontidão e distância.
-- ═════════════════════════════════════════════════════════════
local function styleHighlight(hl: Highlight)
	hl.FillColor           = cfg.HlFillColor
	hl.OutlineColor        = cfg.HlOutlineColor
	hl.FillTransparency    = cfg.HlFillTrans
	hl.OutlineTransparency = cfg.HlOutlineTrans
	hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
end

local function destroyHighlight(e: Entry)
	local hl = e.highlight
	e.highlight = nil
	e.highlightTarget = nil
	e.highlightOn = false
	if hl then
		hl:Destroy()
	end
end

local function applyHighlight(e: Entry, want: boolean)
	local target = e.track.highlightTarget
	local hl = e.highlight
	if want and target then
		-- recria se a entidade mudou ou o jogo removeu/reparentou o Highlight
		if hl == nil or e.highlightTarget ~= target or hl.Parent ~= target then
			destroyHighlight(e)
			local created = Instance.new("Highlight")
			styleHighlight(created)
			created.Adornee = target
			created.Enabled = true
			created.Parent = target
			e.highlight = created
			e.highlightTarget = target
			e.highlightOn = true
		elseif not e.highlightOn then
			hl.Enabled = true
			e.highlightOn = true
		end
	elseif hl and e.highlightOn then
		hl.Enabled = false
		e.highlightOn = false
	end
end

local function closerFirst(a: Entry, b: Entry): boolean
	return a.dist < b.dist
end

-- Liga no máximo HighlightLimit, priorizando os mais próximos; o motor
-- descartaria os excedentes de forma arbitrária.
local function updateHighlights()
	local candidates = highlightCandidates
	local maxDist = cfg.MaxDistance
	for _, e in entries do
		if e.track.ready and e.dist <= maxDist then
			table.insert(candidates, e)
		end
	end
	local limit = TUNING.HighlightLimit
	if #candidates > limit then
		table.sort(candidates, closerFirst)
	end
	highlightStamp += 1
	local stamp = highlightStamp
	for i = 1, math.min(#candidates, limit) do
		candidates[i].highlightStamp = stamp
	end
	table.clear(candidates) -- não retém referências entre ticks
	for _, e in entries do
		applyHighlight(e, e.highlightStamp == stamp)
	end
end

-- ─────────────────────────────────────────────────────────────
--  PLAYERS — ADD / REMOVE (Entry = estado visual + Tracker)
-- ─────────────────────────────────────────────────────────────
local function newEntry(player: Player): Entry
	nextEntryId += 1
	return {
		id = nextEntryId,
		slot = 0,
		player = player,
		destroyed = false,
		playerConns = {},
		track = newTracker(player),
		features = {
			Box = cfg.Box, Bones = cfg.Bones, BoxFill = cfg.BoxFill, Tracer = cfg.Tracer,
			Name = cfg.Name, Distance = cfg.Distance, HealthBar = cfg.HealthBar,
		},
		colors = { Box = cfg.BoxColor, Bones = cfg.BonesColor, Tracer = cfg.TracerColor },

		highlightOn = false,
		displayName = player.DisplayName,
		dist = math.huge,
		tier = 0,
		fade = 1,
		highlightStamp = 0,

		items = {},

		shown = false,
		dirty = true,
		revision = -1,
		trackRevision = -1,
		pX = 0, pY = 0, pW = 0, pH = 0,
		appliedDist = -1,

		bonesShown = false,
		bonePX = {},
		bonePY = {},
		boneVec = {},
		boneValid = {},
		boneChanged = {},
	}
end

local function addPlayer(player: Player)
	if destroyed or player == Players.LocalPlayer or entryByPlayer[player] then
		return
	end

	local e = newEntry(player)
	table.insert(entries, e)
	e.slot = #entries
	entryByPlayer[player] = e

	table.insert(e.playerConns, player:GetPropertyChangedSignal("DisplayName"):Connect(guard("displayName", function()
		if not e.destroyed then
			e.displayName = player.DisplayName
			e.dirty = true
		end
	end)))

	watchSources(e.track)
	resolveAndBind(e.track)
	Groups.resolve(e)
end

-- Ordem pensada para falhas: primeiro sai das listas (o render nunca
-- mais a vê), depois solta fontes, entidade, Highlight e drawings.
local function removeEntry(e: Entry)
	if e.destroyed then
		return
	end
	e.destroyed = true

	local slot, last = e.slot, #entries
	if entries[slot] == e then -- swap-remove O(1)
		local tail = entries[last]
		entries[slot] = tail
		tail.slot = slot
		entries[last] = nil
	end
	if trackCursor > #entries then
		trackCursor = 0
	end
	if entryByPlayer[e.player] == e then
		entryByPlayer[e.player] = nil
	end

	disconnectAll(e.playerConns)
	disposeTracker(e.track)
	destroyHighlight(e)
	releaseItems(e)
end

local function removePlayer(player: Player)
	overrides[player] = nil
	local e = entryByPlayer[player]
	if e then
		removeEntry(e)
	end
end

-- ─────────────────────────────────────────────────────────────
--  HEAVY LOOP — Heartbeat a 20 Hz: estrutura suja e limites (round-robin
--  com orçamento e intervalo por distância) + seleção de Highlights.
-- ─────────────────────────────────────────────────────────────
local function updateTrackers(now: number)
	local n = #entries
	if n == 0 then
		return
	end
	local budget = TUNING.BBoxBudget
	local intervals = TUNING.BBoxInterval
	local maxDist = cfg.MaxDistance
	local start = trackCursor
	for k = 1, n do
		local idx = (start + k - 1) % n + 1
		local e = entries[idx]
		local t = e.track
		local worked = false
		if t.adapter and t.inWorld then
			if t.structureDirty then
				refreshStructure(t)
				worked = true
			elseif t.alive and now >= t.boundsDueAt and (not t.hasBounds or e.dist <= maxDist) then
				-- sem limites ainda: calcula mesmo fora de alcance (senão nunca fica pronta)
				updateBounds(t)
				worked = true
			end
		end
		if worked then
			t.boundsDueAt = now + intervals[math.max(e.tier, 1)]
			budget -= 1
		end
		-- esqueleto: só com Bones ligado e estrutura alterada; mesmo orçamento
		if e.features.Bones and budget > 0 and t.skeletonDirty and t.ready then
			discoverSkeleton(t)
			budget -= 1
		end
		if budget <= 0 then
			trackCursor = idx
			break
		end
	end
end

local function heavyStep(dt: number)
	heavyAccum += dt
	local step = TUNING.HeavyStep
	if heavyAccum < step then
		return
	end
	heavyAccum %= step
	Groups.resolveAll()
	updateTrackers(os.clock())
	if cfg.Highlight then
		updateHighlights()
	end
end

-- ─────────────────────────────────────────────────────────────
--  DRAW — cada elemento em sua função; coordenadas já em pixels inteiros.
-- ─────────────────────────────────────────────────────────────
local function setLine(item: LineItem, from: Vector2, to: Vector2)
	local o = item.obj
	o.From = from
	o.To = to
	show(item)
end

-- `ext` estende as pontas (contorno cobre também a ponta do traço).
local function placeCorners(list: { LineItem }, x0: number, y0: number, x1: number, y1: number, len: number, ext: number)
	setLine(list[1], Vector2.new(x0 - ext, y0), Vector2.new(x0 + len + ext, y0))
	setLine(list[2], Vector2.new(x0, y0 - ext), Vector2.new(x0, y0 + len + ext))
	setLine(list[3], Vector2.new(x1 + ext, y0), Vector2.new(x1 - len - ext, y0))
	setLine(list[4], Vector2.new(x1, y0 - ext), Vector2.new(x1, y0 + len + ext))
	setLine(list[5], Vector2.new(x0 - ext, y1), Vector2.new(x0 + len + ext, y1))
	setLine(list[6], Vector2.new(x0, y1 + ext), Vector2.new(x0, y1 - len - ext))
	setLine(list[7], Vector2.new(x1 + ext, y1), Vector2.new(x1 - len - ext, y1))
	setLine(list[8], Vector2.new(x1, y1 + ext), Vector2.new(x1, y1 - len - ext))
end

local function drawFill(e: Entry, x: number, y: number, w: number, h: number)
	if not e.features.BoxFill then
		hide(e.fill)
		hideSquares(e.bands)
		return
	end
	if cfg.BoxFillMode == "Gradient" then
		hide(e.fill)
		-- bandas com bordas inteiras: sem sobreposição (faixas mais escuras) nem gaps
		local bands = getBands(e)
		local top = y
		for j = 1, FILL_BANDS do
			local bottom = y + math.floor(h * j / FILL_BANDS + 0.5)
			local band = bands[j]
			band.obj.Position = Vector2.new(x, top)
			band.obj.Size = Vector2.new(w, bottom - top)
			show(band)
			top = bottom
		end
	else
		hideSquares(e.bands)
		local fill = getFill(e)
		fill.obj.Position = Vector2.new(x, y)
		fill.obj.Size = Vector2.new(w, h)
		show(fill)
	end
end

local function drawBox(e: Entry, x: number, y: number, w: number, h: number)
	if not e.features.Box then
		hide(e.box)
		hide(e.boxOutline)
		hideLines(e.corners)
		hideLines(e.cornerOutlines)
		return
	end
	local outlined = cfg.Shadows
	if cfg.BoxMode == "Box" then
		hideLines(e.corners)
		hideLines(e.cornerOutlines)
		local pos, size = Vector2.new(x, y), Vector2.new(w, h)
		if outlined then
			local outline = getBoxOutline(e)
			outline.obj.Position = pos
			outline.obj.Size = size
			show(outline)
		else
			hide(e.boxOutline)
		end
		local box = getBox(e)
		box.obj.Position = pos
		box.obj.Size = size
		show(box)
	else
		hide(e.box)
		hide(e.boxOutline)
		local short = math.min(w, h)
		local len = math.clamp(math.floor(short * cfg.CornerRatio + 0.5), LAYOUT.CornerMin, LAYOUT.CornerMax)
		len = math.min(len, math.floor(short * 0.5)) -- cantos nunca se cruzam
		local x1, y1 = x + w, y + h
		if outlined then
			placeCorners(getCornerOutlines(e), x, y, x1, y1, len, LAYOUT.OutlinePx)
		else
			hideLines(e.cornerOutlines)
		end
		placeCorners(getCorners(e), x, y, x1, y1, len, 0)
	end
end

local function drawHealthBar(e: Entry, x: number, y: number, h: number, allowed: boolean)
	local hp01 = e.track.hp01 -- nil = entidade sem informação de vida
	if not (e.features.HealthBar and allowed) or hp01 == nil then
		hide(e.hpBack)
		hide(e.hpFill)
		return
	end
	local o = LAYOUT.OutlinePx
	local bx = x - cfg.HealthBarGap - o - cfg.HealthBarWidth * 0.5
	local bottom = y + h
	setLine(getHpBack(e), Vector2.new(bx, y - o), Vector2.new(bx, bottom + o))

	local fill = getHpFill(e)
	local col = hpColor(hp01)
	if e.appliedHpColor ~= col then
		fill.obj.Color = col
		e.appliedHpColor = col
	end
	setLine(fill, Vector2.new(bx, bottom), Vector2.new(bx, bottom - math.floor(h * hp01 + 0.5)))
end

local function drawName(e: Entry, cx: number, y: number): boolean
	if not e.features.Name then
		hide(e.nameText)
		return false
	end
	local text = getNameText(e)
	local name = e.displayName
	if e.appliedName ~= name then
		text.obj.Text = name
		e.appliedName = name
	end
	text.obj.Position = Vector2.new(cx, y - cfg.TextGap - theme.nameSize)
	show(text)
	return true
end

local function setDistText(e: Entry, text: TextItem, dist: number)
	local meters = math.floor(dist)
	if e.appliedDist ~= meters then
		text.obj.Text = meters .. "m"
		e.appliedDist = meters
	end
end

local function drawDistance(e: Entry, cx: number, bottom: number, dist: number, allowed: boolean): boolean
	if not (e.features.Distance and allowed) then
		hide(e.distText)
		return false
	end
	local text = getDistText(e)
	setDistText(e, text, dist)
	text.obj.Position = Vector2.new(cx, bottom + cfg.TextGap)
	show(text)
	return true
end

-- O tracer termina na borda da box (ou além do texto), nunca cruzando
-- a box nem os rótulos; com origem "Center" mira o centro, como antes.
local function drawTracer(e: Entry, cx: number, y: number, h: number, nameShown: boolean, distShown: boolean)
	if not e.features.Tracer then
		hide(e.tracer)
		hide(e.tracerOutline)
		return
	end
	local gap = cfg.TextGap
	local origin = cfg.TracerOrigin
	local ty: number
	if origin == "Bottom" then
		ty = y + h + (if distShown then 2 * gap + theme.distSize else 0)
	elseif origin == "Top" then
		ty = y - (if nameShown then 2 * gap + theme.nameSize else 0)
	else
		ty = y + h * 0.5
	end
	local target = Vector2.new(cx, ty)
	if cfg.Shadows then
		setLine(getTracerOutline(e), tracerOrigin, target)
	else
		hide(e.tracerOutline)
	end
	setLine(getTracer(e), tracerOrigin, target)
end

local function drawEntry(e: Entry, x: number, y: number, w: number, h: number, dist: number)
	local roomy = h >= cfg.CompactBelow -- box pequena: só o essencial
	local cx = x + w * 0.5
	drawFill(e, x, y, w, h)
	drawBox(e, x, y, w, h)
	drawHealthBar(e, x, y, h, roomy)
	local nameShown = drawName(e, cx, y)
	local distShown = drawDistance(e, cx, y + h, dist, roomy)
	drawTracer(e, cx, y, h, nameShown, distShown)
end

-- ─────────────────────────────────────────────────────────────
--  RENDER — projeção analítica (sem WorldToViewportPoint), snap para
--  pixels inteiros e redraw só quando o retângulo muda.
-- ─────────────────────────────────────────────────────────────
-- ─────────────────────────────────────────────────────────────
--  BONES (visual) — dentro do mesmo loop de render. Cada peça tem o CFrame
--  lido uma vez, cada ponto é projetado uma vez (as linhas compartilham
--  pontos), Vector2 só nasce para pontos que mudaram de pixel e uma linha
--  só é reescrita se uma das pontas mudou. Helpers internos ficam no bloco
--  `do` (o chunk principal do Luau tem limite de 200 locais).
-- ─────────────────────────────────────────────────────────────
local hideBones: (e: Entry) -> ()
local releaseBoneLines: (e: Entry) -> ()
local updateBones: (e: Entry, skel: Skeleton) -> ()
do
	-- posições de mundo do esqueleto em processamento; scratch compartilhado
	-- (as entidades são processadas uma por vez) e só com números
	local worldX: { number } = {}
	local worldY: { number } = {}
	local worldZ: { number } = {}

	local function resetBoneVisuals(e: Entry)
		e.boneSkeleton = nil
		table.clear(e.bonePX)
		table.clear(e.bonePY)
		table.clear(e.boneVec)
		table.clear(e.boneValid)
		table.clear(e.boneChanged)
	end

	hideBones = function(e: Entry)
		if e.bonesShown then
			hideLines(e.bones)
			e.bonesShown = false
		end
	end

	-- Bones desligado: as linhas voltam ao pool e as referências são soltas.
	releaseBoneLines = function(e: Entry)
		if e.bones == nil then
			return
		end
		e.bones = nil
		e.bonesShown = false
		local items = e.items
		for i = #items, 1, -1 do
			local item = items[i]
			if item.kind == "Line" and item.role == "bone" then
				table.remove(items, i)
				if not pcall(releaseItem, item) then
					removeDrawing(item.obj)
				end
			end
		end
		resetBoneVisuals(e)
	end

	-- Novo esqueleto (rig trocou): ajusta arrays e garante linhas suficientes;
	-- linhas excedentes de um rig maior ficam ocultas para reuso.
	local function bindBoneVisuals(e: Entry, skel: Skeleton)
		resetBoneVisuals(e)
		e.boneSkeleton = skel
		local px = e.bonePX
		for i = 1, skel.pointCount do
			px[i] = math.huge -- sentinela: força o primeiro Vector2
		end
		local list: { LineItem } = e.bones or {}
		e.bones = list
		for k = #list + 1, skel.segmentCount do
			list[k] = addLine(e, "bone", k)
		end
		for k = skel.segmentCount + 1, #list do
			setVisible(list[k], false)
		end
	end

	updateBones = function(e: Entry, skel: Skeleton)
		if e.boneSkeleton ~= skel then
			bindBoneVisuals(e, skel)
		end

		-- 1) posições de mundo: uma leitura de CFrame por peça
		local parts, first, last = skel.parts, skel.partFirst, skel.partLast
		local offX, offY, offZ = skel.offX, skel.offY, skel.offZ
		for s = 1, #parts do
			local x, y, z, m00, m01, m02, m10, m11, m12, m20, m21, m22 = parts[s].CFrame:GetComponents()
			for i = first[s], last[s] do
				local ox, oy, oz = offX[i], offY[i], offZ[i]
				worldX[i] = x + m00 * ox + m01 * oy + m02 * oz
				worldY[i] = y + m10 * ox + m11 * oy + m12 * oz
				worldZ[i] = z + m20 * ox + m21 * oy + m22 * oz
			end
		end
		local attachments, isBone = skel.attachments, skel.attachmentIsBone
		local base = skel.attachFirst - 1
		for a = 1, #attachments do
			local att = attachments[a]
			local cf = if isBone[a] then (att :: Bone).TransformedWorldCFrame else att.WorldCFrame
			local x, y, z = cf:GetComponents()
			worldX[base + a], worldY[base + a], worldZ[base + a] = x, y, z
		end

		-- 2) projeção de todos os pontos com a câmera em locais
		local cam = frameCam
		local cpx, cpy, cpz = cam.px, cam.py, cam.pz
		local rX, rY, rZ = cam.rx, cam.ry, cam.rz
		local uX, uY, uZ = cam.ux, cam.uy, cam.uz
		local lX, lY, lZ = cam.lx, cam.ly, cam.lz
		local minDepth, scale, hx, hy = TUNING.MinDepth, projScale, vpHX, vpHY
		local px, py, vec = e.bonePX, e.bonePY, e.boneVec
		local valid, changed = e.boneValid, e.boneChanged
		for i = 1, skel.pointCount do
			local ex, ey, ez = worldX[i] - cpx, worldY[i] - cpy, worldZ[i] - cpz
			local depth = ex * lX + ey * lY + ez * lZ
			if depth <= minDepth then
				valid[i] = false
			else
				local inv = scale / depth
				local sx = math.floor(hx + (ex * rX + ey * rY + ez * rZ) * inv + 0.5)
				local sy = math.floor(hy - (ex * uX + ey * uY + ez * uZ) * inv + 0.5)
				valid[i] = true
				if sx ~= px[i] or sy ~= py[i] then
					px[i], py[i] = sx, sy
					vec[i] = Vector2.new(sx, sy)
					changed[i] = true
				else
					changed[i] = false
				end
			end
		end

		-- 3) linhas: escreve só a ponta que mudou (as duas se estava oculta)
		local lines = e.bones :: { LineItem }
		local segA, segB = skel.segA, skel.segB
		for k = 1, skel.segmentCount do
			local line = lines[k]
			local a, b = segA[k], segB[k]
			if valid[a] and valid[b] then
				local o = line.obj
				if not line.vis then
					o.From = vec[a]
					o.To = vec[b]
					setVisible(line, true)
				else
					if changed[a] then
						o.From = vec[a]
					end
					if changed[b] then
						o.To = vec[b]
					end
				end
			else
				setVisible(line, false) -- uma ponta atrás da câmera
			end
		end
		e.bonesShown = true
	end
end

-- ─────────────────────────────────────────────────────────────
--  GRUPOS — recursos por grupo de jogadores (ex.: "Monster" e
--  "Survivors"). Uma função do usuário diz o grupo de cada jogador; cada
--  grupo pode sobrescrever Box/Bones/BoxFill/Tracer/Name/Distance/
--  HealthBar. O que o grupo não define segue a configuração global.
-- ─────────────────────────────────────────────────────────────
do
	local resolver: ((player: Player, entity: Instance?) -> string?)? = nil
	local overridesByGroup: { [string]: { [string]: boolean } } = {}
	local colorsByGroup: { [string]: { [string]: Color3 } } = {}
	-- cor por grupo → opção global correspondente
	local COLOR_KEYS: { [string]: string } = { Box = "BoxColor", Bones = "BonesColor", Tracer = "TracerColor" }
	local FEATURE_KEYS: { [string]: boolean } = {
		Box = true, Bones = true, BoxFill = true, Tracer = true,
		Name = true, Distance = true, HealthBar = true,
	}

	local function pick(overrides: { [string]: boolean }?, key: string, global: boolean): boolean
		local value = if overrides then overrides[key] else nil
		if value == nil then
			return global
		end
		return value
	end

	-- Cores efetivas; só reestiliza a entry se alguma mudou.
	local function refreshColors(e: Entry)
		local oc = if e.group then colorsByGroup[e.group :: string] else nil
		local c = e.colors
		local box = (oc and oc.Box) or cfg.BoxColor
		local bones = (oc and oc.Bones) or cfg.BonesColor
		local tracer = (oc and oc.Tracer) or cfg.TracerColor
		if box ~= c.Box or bones ~= c.Bones or tracer ~= c.Tracer then
			c.Box, c.Bones, c.Tracer = box, bones, tracer
			restyleEntry(e)
		end
	end

	-- Recalcula os recursos efetivos de uma entry; só marca redraw se mudou.
	local function refresh(e: Entry)
		refreshColors(e)
		local o = if e.group then overridesByGroup[e.group :: string] else nil
		local f = e.features
		local box, bones = pick(o, "Box", cfg.Box), pick(o, "Bones", cfg.Bones)
		local fill, tracer = pick(o, "BoxFill", cfg.BoxFill), pick(o, "Tracer", cfg.Tracer)
		local name, dist = pick(o, "Name", cfg.Name), pick(o, "Distance", cfg.Distance)
		local hp = pick(o, "HealthBar", cfg.HealthBar)
		if box == f.Box and bones == f.Bones and fill == f.BoxFill and tracer == f.Tracer
			and name == f.Name and dist == f.Distance and hp == f.HealthBar
		then
			return
		end
		local bonesChanged = bones ~= f.Bones
		f.Box, f.Bones, f.BoxFill, f.Tracer = box, bones, fill, tracer
		f.Name, f.Distance, f.HealthBar = name, dist, hp
		e.dirty = true
		if bonesChanged then
			-- desligado: sem descoberta nem linhas; ligado: redescobre
			local t = e.track
			t.skeleton = nil
			t.skeletonDirty = true
			if not bones then
				releaseBoneLines(e)
			end
		end
	end

	local function resolve(e: Entry)
		local group: string? = nil
		local fn = resolver
		if fn then
			local ok, result = pcall(fn, e.player, e.track.entity)
			if not ok then
				reportError("resolvedor de grupo", result)
			elseif type(result) == "string" then
				group = result
			end
		end
		if group ~= e.group then
			e.group = group
			refresh(e)
		end
	end

	local function refreshGroup(group: string)
		for _, e in entries do
			if e.group == group then
				refresh(e)
			end
		end
	end

	Groups = {
		refresh = refresh,
		resolve = resolve,
		refreshAll = function()
			for _, e in entries do
				refresh(e)
			end
		end,
		-- chamado a cada tick do loop pesado: grupos mudam (times, rodadas)
		resolveAll = function()
			if resolver then
				for _, e in entries do
					resolve(e)
				end
			end
		end,
		setResolver = function(fn: unknown): boolean
			if fn ~= nil and type(fn) ~= "function" then
				warn("[ESP] SetGroupResolver espera uma função (player, entity) -> string? ou nil")
				return false
			end
			resolver = fn :: ((player: Player, entity: Instance?) -> string?)?
			for _, e in entries do
				resolve(e)
			end
			return true
		end,
		setFeature = function(group: unknown, key: unknown, value: unknown): boolean
			if type(group) ~= "string" or type(key) ~= "string" or not FEATURE_KEYS[key] then
				warn(string.format("[ESP] SetGroupFeature: grupo/recurso inválido (%s, %s); recursos: Box, Bones, BoxFill, Tracer, Name, Distance, HealthBar", tostring(group), tostring(key)))
				return false
			end
			if value ~= nil and type(value) ~= "boolean" then
				warn(string.format("[ESP] SetGroupFeature: %s espera boolean ou nil (volta ao global)", key))
				return false
			end
			local overrides = overridesByGroup[group]
			if overrides == nil then
				overrides = {}
				overridesByGroup[group] = overrides
			end
			overrides[key] = value :: boolean?
			refreshGroup(group)
			return true
		end,
		setColor = function(group: unknown, key: unknown, value: unknown): boolean
			if type(group) ~= "string" or type(key) ~= "string" or COLOR_KEYS[key] == nil then
				warn(string.format("[ESP] SetGroupColor: grupo/cor inválido (%s, %s); cores: Box, Bones, Tracer", tostring(group), tostring(key)))
				return false
			end
			if value ~= nil and typeof(value) ~= "Color3" then
				warn(string.format("[ESP] SetGroupColor: %s espera Color3 ou nil (volta à cor global)", key))
				return false
			end
			local colors = colorsByGroup[group]
			if colors == nil then
				colors = {}
				colorsByGroup[group] = colors
			end
			colors[key] = value :: Color3?
			refreshGroup(group)
			return true
		end,
		getGroup = function(player: Player): string?
			local e = entryByPlayer[player]
			return if e then e.group else nil
		end,
		clear = function()
			resolver = nil
			table.clear(overridesByGroup)
			table.clear(colorsByGroup)
		end,
	}
end

local function resolveTier(dist: number, current: number, near: number, mid: number): number
	local raw = if dist < near then 1 elseif dist < mid then 2 else 3
	if current == 0 or raw == current then
		return raw
	end
	local band = TUNING.TierHysteresis
	if math.abs(dist - near) < band or math.abs(dist - mid) < band then
		return current
	end
	return raw
end

local function renderStep()
	local n = #entries
	local cam = camera
	if cam == nil then
		-- sem câmera não há projeção válida: não deixa drawings congelados
		for i = 1, n do
			local e = entries[i]
			if e.shown then hideAll(e) end
		end
		return
	end
	frameCount += 1
	if n == 0 then
		return
	end

	-- colunas da matriz da câmera: X = right, Y = up, -Z = look
	local cpx, cpy, cpz, c00, c01, c02, c10, c11, c12, c20, c21, c22 = cam.CFrame:GetComponents()
	local rX, rY, rZ = c00, c10, c20
	local uX, uY, uZ = c01, c11, c21
	local lX, lY, lZ = -c02, -c12, -c22
	local fc = frameCam
	fc.px, fc.py, fc.pz = cpx, cpy, cpz
	fc.rx, fc.ry, fc.rz = rX, rY, rZ
	fc.ux, fc.uy, fc.uz = uX, uY, uZ
	fc.lx, fc.ly, fc.lz = lX, lY, lZ

	local maxDist = cfg.MaxDistance
	local near, mid = cfg.DistNear, cfg.DistMid
	local frameIntervals = TUNING.FrameInterval
	local minDepth = TUNING.MinDepth
	local minPx = TUNING.MinBoxPx
	local scale = projScale
	local currentRevision = revision
	local bonesMaxDist = cfg.BonesMaxDistance
	local compactBelow = cfg.CompactBelow

	for i = 1, n do
		local e = entries[i]
		local t = e.track
		if e.highlight and e.highlightTarget ~= t.highlightTarget then
			destroyHighlight(e) -- entidade trocou: Highlight antigo sai na hora
		end
		if not t.ready then
			e.dist = math.huge
			if e.shown then hideAll(e) end
			local hl = e.highlight
			if hl and e.highlightOn then
				hl.Enabled = false -- morte/remoção: reação no mesmo frame
				e.highlightOn = false
			end
			continue
		end

		-- âncora: BasePart (CFrame) ou Attachment (WorldCFrame)
		local anchorCF: CFrame
		local anchorPart = t.anchorPart
		if anchorPart then
			anchorCF = anchorPart.CFrame
		else
			local attachment = t.anchorAttachment
			if attachment == nil then
				if e.shown then hideAll(e) end
				continue
			end
			anchorCF = attachment.WorldCFrame
		end

		local px, py, pz, r00, r01, r02, r10, r11, r12, r20, r21, r22 = anchorCF:GetComponents()
		local dx, dy, dz = px - cpx, py - cpy, pz - cpz
		local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
		e.dist = dist
		if dist > maxDist then
			if e.shown then hideAll(e) end
			continue
		end

		-- nível de distância: troca de opacidade só quando o nível muda
		local tier = resolveTier(dist, e.tier, near, mid)
		if tier ~= e.tier then
			e.tier = tier
			local fade = fadeForTier(tier)
			if fade ~= e.fade then
				e.fade = fade
				restyleEntry(e)
			end
		end

		-- LOD: longe atualiza a cada N frames, distribuído pelo id
		local full = e.dirty or e.revision ~= currentRevision or e.trackRevision ~= t.revision or not e.shown
		if not full then
			local interval = frameIntervals[tier]
			if interval > 1 and (frameCount + e.id) % interval ~= 0 then
				continue
			end
		end

		-- centro dos limites no mundo = âncora + R * offset local (relativo à câmera)
		local ox, oy, oz = t.offX, t.offY, t.offZ
		local ex = px + r00 * ox + r01 * oy + r02 * oz - cpx
		local ey = py + r10 * ox + r11 * oy + r12 * oz - cpy
		local ez = pz + r20 * ox + r21 * oy + r22 * oz - cpz

		local depth = ex * lX + ey * lY + ez * lZ
		if depth <= minDepth then
			if e.shown then hideAll(e) end
			continue
		end

		local inv = scale / depth
		local cx = vpHX + (ex * rX + ey * rY + ez * rZ) * inv
		local cy = vpHY - (ex * uX + ey * uY + ez * uZ) * inv

		-- extensão da caixa orientada projetada nos eixos da tela
		local hx, hy, hz = t.halfX, t.halfY, t.halfZ
		local w = 2 * inv * (
			math.abs(rX * r00 + rY * r10 + rZ * r20) * hx
			+ math.abs(rX * r01 + rY * r11 + rZ * r21) * hy
			+ math.abs(rX * r02 + rY * r12 + rZ * r22) * hz)
		local h = 2 * inv * (
			math.abs(uX * r00 + uY * r10 + uZ * r20) * hx
			+ math.abs(uX * r01 + uY * r11 + uZ * r21) * hy
			+ math.abs(uX * r02 + uY * r12 + uZ * r22) * hz)

		-- margem de tela (deixa passar box parcialmente visível)
		if cx < -w or cx > vpX + w or cy < -h or cy > vpY + h then
			if e.shown then hideAll(e) end
			continue
		end

		-- snap para pixels inteiros: traços nítidos e sem tremulação subpixel
		local wi = math.max(math.floor(w + 0.5), minPx)
		local hi = math.max(math.floor(h + 0.5), minPx)
		local x = math.floor(cx - wi * 0.5 + 0.5)
		local y = math.floor(cy - hi * 0.5 + 0.5)

		-- bones: teste de mudança próprio (membros animam com a box parada)
		if e.features.Bones then
			local skel = t.skeleton
			if skel and dist <= bonesMaxDist and hi >= compactBelow then
				updateBones(e, skel)
			elseif e.bonesShown then
				hideBones(e)
			end
		end

		-- retângulo idêntico e nada mudou → só o texto de distância
		if not full and x == e.pX and y == e.pY and wi == e.pW and hi == e.pH then
			local text = e.distText
			if text and text.vis then
				setDistText(e, text, dist)
			end
			continue
		end

		e.pX, e.pY, e.pW, e.pH = x, y, wi, hi
		e.revision = currentRevision
		e.trackRevision = t.revision
		e.dirty = false
		drawEntry(e, x, y, wi, hi, dist)
		e.shown = true
	end
end

-- ─────────────────────────────────────────────────────────────
--  CONFIG API — validação pelo schema + aplicação só do efeito.
-- ─────────────────────────────────────────────────────────────
local function normalize(spec: FieldSpec, value: unknown): ConfigValue?
	if spec.kind == "boolean" then
		if type(value) == "boolean" then
			return value
		end
	elseif spec.kind == "color" then
		if typeof(value) == "Color3" then
			return value
		end
	elseif spec.kind == "string" then
		if type(value) == "string" and #value > 0 and #value <= 100 then
			return value
		end
	elseif spec.kind == "enum" then
		local options = spec.options
		if type(value) == "string" and options and options[value] then
			return value
		end
	elseif type(value) == "number" and value == value then -- rejeita NaN
		local n = if spec.integer then math.floor(value + 0.5) else value
		return math.clamp(n, spec.min or -math.huge, spec.max or math.huge)
	end
	return nil
end

local function applyEffect(effect: Effect)
	revision += 1
	if effect == "restyle" then
		rebuildTheme()
		restyleAll()
	elseif effect == "highlightStyle" then
		for _, e in entries do
			local hl = e.highlight
			if hl then
				styleHighlight(hl)
			end
		end
	elseif effect == "highlightToggle" then
		if not cfg.Highlight then
			for _, e in entries do
				destroyHighlight(e)
			end
		end
	elseif effect == "tracer" then
		updateTracerOrigin()
	elseif effect == "rebindHealth" then
		for _, e in entries do
			local t = e.track
			if t.entity and t.adapter then
				rebindHealth(t, t.healthHumanoid)
			end
		end
	elseif effect == "bounds" then
		for _, e in entries do
			e.track.boundsDueAt = 0
		end
	elseif effect == "structure" then
		-- peças da caixa recoletadas no loop pesado (com orçamento)
		for _, e in entries do
			e.track.structureDirty = true
		end
	end
	-- recursos efetivos (grupo → global) acompanham qualquer mudança global;
	-- Bones desligado libera linhas e esqueleto da entry (custo zero)
	Groups.refreshAll()
end

local function setConfig(key: string, value: unknown): boolean
	local spec = if type(key) == "string" then SCHEMA[key] else nil
	if spec == nil then
		warn(string.format("[ESP] opção de config desconhecida: %s", tostring(key)))
		return false
	end
	local normalized = normalize(spec, value)
	if normalized == nil then
		warn(string.format("[ESP] valor inválido para %s: %s (%s)", key, tostring(value), typeof(value)))
		return false
	end
	-- único ponto de escrita dinâmica (chave validada pelo SCHEMA acima)
	local store = cfg :: any
	if store[key] == normalized then
		return true
	end
	store[key] = normalized
	applyEffect(spec.effect)
	return true
end

local function setConfigMany(values: { [string]: unknown }): boolean
	local allOk = true
	for key, value in values do
		if not setConfig(key, value) then
			allOk = false
		end
	end
	return allOk
end

-- Sem chave: cópia de todas as opções (alterá-la não afeta nada).
local function getConfig(key: string?): unknown
	if key == nil then
		return table.clone(cfg)
	end
	return if SCHEMA[key] then (cfg :: any)[key] else nil
end

-- Garante que DEFAULT_CONFIG e SCHEMA não divergem (erro de manutenção).
local function validateDefaults()
	local defaults = DEFAULT_CONFIG :: any
	for key in defaults do
		assert(SCHEMA[key] ~= nil, "[ESP] opção sem schema: " .. tostring(key))
	end
	for key, spec in SCHEMA do
		local value = defaults[key]
		assert(value ~= nil and normalize(spec, value) == value, "[ESP] padrão inválido: " .. key)
	end
end

-- Proxy: `ESP.Config.X = v` passa por setConfig (compatível com UIs que
-- escreviam direto na tabela Config original). Metatabelas não são
-- tipáveis em strict; a fronteira é convertida para Config uma vez.
local configProxy = setmetatable({}, {
	__index = function(_, key: string): unknown
		return getConfig(key)
	end,
	__newindex = function(_, key: string, value: unknown)
		setConfig(key, value)
	end,
	__iter = function()
		return next, table.clone(cfg)
	end,
})

-- ─────────────────────────────────────────────────────────────
--  API DE INTEGRAÇÃO DE ENTIDADES — tudo que vem de fora é validado
--  antes de entrar; as funções do usuário rodam sempre protegidas.
-- ─────────────────────────────────────────────────────────────
-- Validadores internos ficam no bloco; só as funções públicas saem.
local setEntitySources: (list: unknown) -> boolean
local registerAdapter: (value: unknown) -> boolean
local unregisterAdapter: (name: string) -> boolean
do
	local function isFunction(value: unknown): boolean
		return type(value) == "function"
	end

	local function validateSource(value: unknown): EntitySource?
		if type(value) ~= "table" then
			return nil
		end
		local fields = value :: { [string]: unknown }
		if type(fields.name) ~= "string" or not isFunction(fields.resolve) or not isFunction(fields.watch) then
			return nil
		end
		return value :: EntitySource
	end

	local OPTIONAL_ADAPTER_FUNCTIONS = { "findAnchor", "collectParts", "readHealth", "watchHealth", "getSkeleton" }

	local function validateAdapter(value: unknown): EntityAdapter?
		if type(value) ~= "table" then
			return nil
		end
		local fields = value :: { [string]: unknown }
		if type(fields.name) ~= "string" or not isFunction(fields.accepts) then
			return nil
		end
		for _, key in OPTIONAL_ADAPTER_FUNCTIONS do
			local fn = fields[key]
			if fn ~= nil and not isFunction(fn) then
				return nil
			end
		end
		return value :: EntityAdapter
	end

	-- Adaptadores mudaram: cada entidade é religada e o adaptador é re-escolhido.
	local function rebindAll()
		for _, e in entries do
			local t = e.track
			local entity, sourceName = t.entity, t.sourceName
			if entity then
				bindEntity(t, entity, sourceName)
			end
		end
	end

	setEntitySources = function(list: unknown): boolean
		if type(list) ~= "table" then
			warn("[ESP] SetEntitySources espera uma lista de fontes")
			return false
		end
		local validated: { EntitySource } = {}
		for i, value in list :: { unknown } do
			local source = validateSource(value)
			if source == nil then
				warn(string.format("[ESP] fonte #%s inválida: espera { name, resolve, watch }", tostring(i)))
				return false
			end
			table.insert(validated, source)
		end
		if #validated == 0 then
			warn("[ESP] SetEntitySources: a lista não pode ser vazia")
			return false
		end
		entitySources = validated
		for _, e in entries do
			watchSources(e.track)
			resolveAndBind(e.track)
		end
		return true
	end

	-- Prioridade = ordem de registro; registrar de novo o mesmo nome substitui.
	registerAdapter = function(value: unknown): boolean
		local adapter = validateAdapter(value)
		if adapter == nil then
			warn("[ESP] adaptador inválido: espera { name, accepts, findAnchor?, collectParts?, readHealth?, watchHealth?, getSkeleton? }")
			return false
		end
		for i, existing in adapters do
			if existing.name == adapter.name then
				table.remove(adapters, i)
				break
			end
		end
		table.insert(adapters, adapter)
		rebindAll()
		return true
	end

	unregisterAdapter = function(name: string): boolean
		for i, existing in adapters do
			if existing.name == name then
				table.remove(adapters, i)
				rebindAll()
				return true
			end
		end
		return false
	end
end

-- Integração "push": o sistema de controle do jogo informa a entidade.
-- Tem prioridade sobre todas as fontes; nil devolve o controle a elas.
-- É limpo automaticamente se a entidade for destruída ou o jogador sair.
local function setControlledEntity(player: Player, entity: Instance?): boolean
	if typeof(player) ~= "Instance" or not player:IsA("Player") or (entity ~= nil and typeof(entity) ~= "Instance") then
		warn("[ESP] uso: SetControlledEntity(player: Player, entity: Instance?)")
		return false
	end
	overrides[player] = entity
	local e = entryByPlayer[player]
	if e then
		resolveAndBind(e.track)
	end
	return true
end

-- Para integrações sem sinais: força nova resolução e releitura da estrutura.
local function refreshEntity(player: Player?)
	for _, e in entries do
		if player == nil or e.player == player then
			local t = e.track
			resolveAndBind(t)
			if t.entity and t.adapter then
				refreshStructure(t)
			end
		end
	end
end

local function getEntityInfo(player: Player): EntityInfo?
	local e = entryByPlayer[player]
	if e == nil then
		return nil
	end
	local t = e.track
	local anchor: Instance? = t.anchorPart or t.anchorAttachment
	return {
		status = t.status,
		reason = t.reason,
		entity = t.entity,
		source = t.sourceName,
		adapter = if t.adapter then t.adapter.name else nil,
		anchor = anchor,
		partCount = t.partCount,
		health01 = t.hp01,
		skeleton = if t.skeleton then t.skeleton.kind else nil,
		boneCount = if t.skeleton then t.skeleton.segmentCount else 0,
	}
end

-- ─────────────────────────────────────────────────────────────
--  SHUTDOWN — idempotente; cada etapa continua mesmo se outra falhar.
-- ─────────────────────────────────────────────────────────────
local function attempt(context: string, fn: () -> ())
	local ok, err = pcall(fn)
	if not ok then
		warn(string.format("[ESP] falha ao encerrar (%s): %s", context, tostring(err)))
	end
end

local function destroy()
	if destroyed then
		return
	end
	destroyed = true
	attempt("render", function()
		RunService:UnbindFromRenderStep(renderBindName)
	end)
	disconnectAll(globalConns)
	disconnectAll(cameraConns)
	for i = #entries, 1, -1 do
		local e = entries[i]
		if e then
			attempt("player", function()
				removeEntry(e)
			end)
		end
	end
	table.clear(entries)
	table.clear(entryByPlayer)
	table.clear(highlightCandidates)
	table.clear(overrides)
	table.clear(adapters)
	Groups.clear()
	drainPools()
	camera = nil
	local registered = SharedEnv[INSTANCE_KEY]
	if type(registered) == "table" and registered.Destroy == destroy then
		SharedEnv[INSTANCE_KEY] = nil
	end
	local public = SharedEnv.ESP
	if type(public) == "table" and public.Destroy == destroy then
		SharedEnv.ESP = nil
	end
end

-- ─────────────────────────────────────────────────────────────
--  INIT
-- ─────────────────────────────────────────────────────────────
local function init()
	validateDefaults()
	entitySources = { characterSource() }
	bindCamera()
	rebuildTheme()
	updateTracerOrigin()

	table.insert(globalConns, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(guard("camera", bindCamera)))
	table.insert(globalConns, Players.PlayerAdded:Connect(guard("playerAdded", addPlayer)))
	table.insert(globalConns, Players.PlayerRemoving:Connect(guard("playerRemoving", removePlayer)))
	-- LocalPlayer pode ser atribuído depois (autoexec muito cedo)
	table.insert(globalConns, Players:GetPropertyChangedSignal("LocalPlayer"):Connect(guard("localPlayer", function()
		local localPlayer = Players.LocalPlayer
		if localPlayer then
			removePlayer(localPlayer)
		end
	end)))
	table.insert(globalConns, RunService.Heartbeat:Connect(guard("heavy", heavyStep)))

	-- Depois da câmera (prioridade 200): projeta com o CFrame deste frame.
	RunService:BindToRenderStep(renderBindName, Enum.RenderPriority.Camera.Value + 1, guard("render", renderStep))

	for _, player in Players:GetPlayers() do
		addPlayer(player)
	end
end

local api: ESPApi = {
	Version = "6.4.0",
	Config = (configProxy :: any) :: Config,
	Defaults = table.clone(DEFAULT_CONFIG), -- cópia: alterá-la não afeta nada
	SetConfig = setConfig,
	SetConfigMany = setConfigMany,
	GetConfig = getConfig,
	Refresh = function()
		revision += 1
	end,
	IsDestroyed = function(): boolean
		return destroyed
	end,
	Destroy = destroy,

	Sources = {
		Character = characterSource,
		Vehicle = vehicleSource,
		ObjectValue = objectValueSource,
	},
	Generic = {
		accepts = genericAccepts,
		findAnchor = genericFindAnchor,
		collectParts = genericCollectParts,
		readHealth = genericReadHealth,
		watchHealth = genericWatchHealth,
	},
	SetEntitySources = setEntitySources,
	RegisterAdapter = registerAdapter,
	UnregisterAdapter = unregisterAdapter,
	SetControlledEntity = setControlledEntity,
	RefreshEntity = refreshEntity,
	GetEntityInfo = getEntityInfo,
	DiagnoseSkeleton = function(player: Player): SkeletonDiagnosis?
		local e = entryByPlayer[player]
		if e == nil then
			return nil
		end
		local report = diagnoseSkeleton(e.track)
		report.bonesEnabled = e.features.Bones
		local lines = e.bones
		if lines then
			for _, line in lines do
				if line.vis then
					report.visibleLines += 1
				end
			end
		end
		return report
	end,

	SetGroupResolver = function(fn: ((player: Player, entity: Instance?) -> string?)?): boolean
		return Groups.setResolver(fn)
	end,
	SetGroupFeature = function(group: string, key: string, value: boolean?): boolean
		return Groups.setFeature(group, key, value)
	end,
	-- key: "Box" | "Bones" | "Tracer"; nil volta à cor global (BoxColor...)
	SetGroupColor = function(group: string, key: string, color: Color3?): boolean
		return Groups.setColor(group, key, color)
	end,
	SetGroupFeatures = function(group: string, values: { [string]: boolean }): boolean
		if type(values) ~= "table" then
			warn("[ESP] SetGroupFeatures espera uma tabela { Recurso = boolean }")
			return false
		end
		local allOk = true
		for key, value in values do
			if not Groups.setFeature(group, key, value) then
				allOk = false
			end
		end
		return allOk
	end,
	GetGroup = function(player: Player): string?
		return Groups.getGroup(player)
	end,
}

-- Registra antes de conectar: uma falha parcial na inicialização ainda
-- pode ser limpa por destroy() ou por uma re-execução.
SharedEnv[INSTANCE_KEY] = api
if not xpcall(init, captureTrace) then
	local trace = lastTrace
	destroy()
	error("[ESP] falha na inicialização:\n" .. trace, 0)
end

-- `loadstring(...)()` descarta o retorno: a API fica em getgenv().ESP.
SharedEnv.ESP = api
print("[ESP] " .. api.Version .. " carregado — API em getgenv().ESP")
return api
