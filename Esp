	return item
end

local function getDistText(e: Entry): TextItem
	local existing = e.distText
	if existing then return existing end
	local item = addText(e, "dist")
	e.distText = item
	e.appliedDist = -1
	return item
end

local function releaseItem(item: Item)
	setVisible(item, false)
	local pooled = false
	if item.kind == "Square" then
		pooled = tryPool(squarePool, item.obj)
	elseif item.kind == "Line" then
		pooled = tryPool(linePool, item.obj)
	else
		pooled = tryPool(textPool, item.obj)
	end
	if not pooled then
		removeDrawing(item.obj)
	end
end

local function releaseItems(e: Entry)
	local items = e.items
	for i = #items, 1, -1 do
		local item = items[i]
		items[i] = nil
		-- um drawing removido externamente não pode impedir a limpeza dos demais
		if not pcall(releaseItem, item) then
			removeDrawing(item.obj)
		end
	end
	e.fill = nil; e.bands = nil; e.boxOutline = nil; e.box = nil
	e.cornerOutlines = nil; e.corners = nil; e.tracerOutline = nil; e.tracer = nil
	e.hpBack = nil; e.hpFill = nil; e.nameText = nil; e.distText = nil
	e.shown = false
	e.bones = nil
	e.bonesShown = false
	e.boneSkeleton = nil
	table.clear(e.boneVec)
end

-- ─────────────────────────────────────────────────────────────
--  VIEWPORT + PROJECTION (atualizado por evento)
--  pixel = vpH/2 ± (offset·eixo) * projScale / profundidade
-- ─────────────────────────────────────────────────────────────
local function updateTracerOrigin()
	local origin = cfg.TracerOrigin
	local y = if origin == "Bottom" then vpY elseif origin == "Top" then 0 else vpHY
	tracerOrigin = Vector2.new(vpHX, y)
end

local function updateProjection()
	local cam = camera
	if cam == nil then
		return
	end
	local vp = cam.ViewportSize
	vpX, vpY = vp.X, vp.Y
	vpHX, vpHY = vpX * 0.5, vpY * 0.5
	projScale = vpY / (2 * math.tan(math.rad(cam.FieldOfView) * 0.5))
	updateTracerOrigin()
	if computeUiScale() ~= theme.uiScale then
		rebuildTheme()
		restyleAll()
	end
	revision += 1
end

-- CurrentCamera pode ser substituída; as conexões acompanham a câmera atual.
local function bindCamera()
	disconnectAll(cameraConns)
	local cam = workspace.CurrentCamera
	camera = cam
	if cam then
		table.insert(cameraConns, cam:GetPropertyChangedSignal("ViewportSize"):Connect(guard("viewport", updateProjection)))
		table.insert(cameraConns, cam:GetPropertyChangedSignal("FieldOfView"):Connect(guard("fov", updateProjection)))
		updateProjection()
	end
end

