--!strict
--[[
	ESP (Drawing API) — módulo remoto

	Ambiente: executor com Drawing API. `Drawing`, `getgenv`, `loadstring` e
	`game:HttpGet` NÃO existem no Roblox padrão; todo o resto (Players,
	RunService, Camera, Highlight, BindToRenderStep, HttpService) é API oficial.
	Tipos das APIs de executor: types/executor.d.luau (só para o analisador).

	Carregamento (o arquivo inteiro é um chunk que retorna a API):
		loadstring(game:HttpGet("https://raw.githubusercontent.com/USUARIO/REPOSITORIO/main/ESP.luau"))()
	A API também fica em getgenv().ESP. Executar de novo substitui a
	instância anterior. Documentação: README.md.

	Uso:
		ESP.Config.Name = true                -- escrita direta (validada)
		ESP.SetConfig("BoxMode", "Corner")    -- retorna true/false
		ESP.SetConfigMany({ Distance = true, HealthBar = true })
		ESP.Destroy()                         -- limpeza total (idempotente)

	Entidades (personagens customizados, veículos, robôs...):
		-- quem o jogador controla: fontes em ordem de prioridade
		ESP.SetEntitySources({ ESP.Sources.ObjectValue("ControlledEntity"),
			ESP.Sources.Vehicle(), ESP.Sources.Character() })
		-- ou o seu sistema de controle informa diretamente
		ESP.SetControlledEntity(player, robotModel)   -- nil volta às fontes
		-- como ler um tipo de entidade (só name/accepts são obrigatórios)
		ESP.RegisterAdapter({ name = "Mech", accepts = ..., findAnchor = ... })
		ESP.Config.Bones = true                       -- esqueleto (R6/R15/juntas/Bone/adaptador)
		print(ESP.DiagnoseSkeleton(player).rig)       -- diagnóstico do esqueleto
		print(ESP.GetEntityInfo(player).status)       -- diagnóstico

	Executar o script de novo encerra automaticamente a instância anterior.
]]

-- ─────────────────────────────────────────────────────────────
--  SERVICES + AMBIENTE
-- ─────────────────────────────────────────────────────────────
local Players     = game:GetService("Players")
local RunService  = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

-- Carregado cedo (autoexec): espera o jogo terminar de carregar.
if not game:IsLoaded() then
	game.Loaded:Wait()
end

if Drawing == nil or typeof(Drawing.new) ~= "function" then
	error("[ESP] Drawing API indisponível (requer executor com Drawing).", 0)
end

-- Fronteira com o executor: getgenv/_G são tabelas dinâmicas por natureza.
local SharedEnv: { [string]: any } = if typeof(getgenv) == "function" then getgenv() else _G
local INSTANCE_KEY = "__ESP_DRAWING_INSTANCE"

do -- encerra a instância anterior (re-execução não duplica nada)
	local previous = SharedEnv[INSTANCE_KEY]
	if type(previous) == "table" and type(previous.Destroy) == "function" then
		local ok, err = pcall(previous.Destroy)
		if not ok then
			warn("[ESP] falha ao encerrar instância anterior: " .. tostring(err))
		end
	end
end

