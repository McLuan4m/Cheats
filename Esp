type ConfigValue = boolean | number | string | Color3

-- Efeito de uma mudança de config (o que precisa ser reaplicado).
type Effect = "redraw" | "restyle" | "highlightStyle" | "highlightToggle" | "tracer" | "rebindHealth" | "bounds" | "bones" | "structure"

type FieldSpec = {
	kind: "boolean" | "number" | "color" | "enum" | "string",
	effect: Effect,
	min: number?,
	max: number?,
	integer: boolean?,
	options: { [string]: boolean }?,
}

type SquareRole = "fill" | "band" | "boxOutline" | "box"
type LineRole = "cornerOutline" | "corner" | "tracerOutline" | "tracer" | "hpBack" | "hpFill" | "bone"
type TextRole = "name" | "dist"

-- União discriminada por `kind`; `vis` espelha obj.Visible em Lua.
type SquareItem = { kind: "Square", role: SquareRole, index: number, obj: DrawingSquare, vis: boolean }
type LineItem = { kind: "Line", role: LineRole, index: number, obj: DrawingLine, vis: boolean }
type TextItem = { kind: "Text", role: TextRole, index: number, obj: DrawingText, vis: boolean }
type Item = SquareItem | LineItem | TextItem
type AnyDrawing = DrawingSquare | DrawingLine | DrawingText

type Theme = {
